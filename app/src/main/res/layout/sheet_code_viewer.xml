<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/themeSurface"
    android:padding="16dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_chat_status" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_code_chip"
            app:tint="?attr/themeAccent"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCodeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Code Viewer"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tvCodeSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 lines"
                android:textColor="?attr/themeTextSecondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCodeCopy"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_chat_header_icon"
            android:src="@drawable/ic_cc_copy"
            app:tint="?attr/themeTextPrimary"
            android:padding="8dp"
            android:contentDescription="Copy full code" />

        <ImageButton
            android:id="@+id/btnCodeClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chat_header_icon"
            android:src="@drawable/ic_close"
            app:tint="?attr/themeTextPrimary"
            android:padding="8dp"
            android:contentDescription="Close viewer" />
    </LinearLayout>

    <!-- Theme Selector Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="THEME:"
            android:textColor="?attr/themeTextSecondary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/chipThemeCyber"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_auto_approve_badge_active"
            android:text="Cyber Dark+"
            android:textColor="?attr/themeAccent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/chipThemeDracula"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_auto_approve_badge_inactive"
            android:text="Dracula"
            android:textColor="?attr/themeTextSecondary"
            android:textSize="11sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/chipThemeMonokai"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/bg_auto_approve_badge_inactive"
            android:text="Monokai Neon"
            android:textColor="?attr/themeTextSecondary"
            android:textSize="11sp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollCodeContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="?attr/themeInputBg"
        android:padding="12dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvLineNumbers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/themeTextMuted"
                    android:fontFamily="monospace"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp"
                    android:gravity="end"
                    android:paddingEnd="12dp" />

                <TextView
                    android:id="@+id/tvCodeContent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/themeTextPrimary"
                    android:fontFamily="monospace"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp"
                    android:textIsSelectable="true" />
            </LinearLayout>
        </HorizontalScrollView>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
