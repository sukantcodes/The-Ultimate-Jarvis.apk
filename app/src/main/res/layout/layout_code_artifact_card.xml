<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_code_artifact_card"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_code_header"
        android:paddingStart="10dp"
        android:paddingEnd="8dp">

        <!-- Claude-style reactive animated icon frame -->
        <FrameLayout
            android:id="@+id/flCardIconContainer"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_work_icon_frame"
            android:layout_marginEnd="8dp">

            <ImageView
                android:id="@+id/ivCardIcon"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_work_file_create"
                app:tint="?attr/themeAccent"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvCardLanguage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CODE"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tvWritingStatus"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:background="@drawable/bg_code_writing_badge"
            android:text="✦ Writing code…"
            android:textColor="?attr/themeAccent"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Down arrow / Tag toggle button -->
        <LinearLayout
            android:id="@+id/btnToggleMiniTerminal"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_auto_approve_chip"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="4dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvToggleTagText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▼ Code Window"
                android:textColor="?attr/themeAccent"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnCardCopy"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="7dp"
            android:src="@drawable/ic_cc_copy"
            app:tint="?attr/themeTextSecondary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Copy code"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnCardExpand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open ↗"
            android:textColor="?attr/themeAccent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Expandable Mini Terminal / Code Window -->
    <LinearLayout
        android:id="@+id/layoutMiniTerminal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/themeInputBg"
        android:visibility="visible">

        <!-- Mini Terminal Top Bar with macOS/Terminal dots -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/themeInputBg"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/bg_chat_status"
                android:backgroundTint="?attr/themeError" />

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_chat_status"
                android:backgroundTint="?attr/themeWarning" />

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_chat_status"
                android:backgroundTint="?attr/themeSuccess" />

            <TextView
                android:id="@+id/tvTerminalTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="terminal ~/workspace"
                android:textColor="?attr/themeTextMuted"
                android:textSize="9sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutCodePreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tvPreviewLineNumbers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/themeTextMuted"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp"
                android:gravity="end"
                android:paddingEnd="10dp" />

            <TextView
                android:id="@+id/tvPreviewCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/themeTextSecondary"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp"
                android:maxLines="8"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvCardBottomHint"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:gravity="center"
        android:background="?attr/themeInputBg"
        android:text="Tap tag to toggle mini window · Open ↗ for fullscreen viewer"
        android:textColor="?attr/themeTextMuted"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.04" />

</LinearLayout>
