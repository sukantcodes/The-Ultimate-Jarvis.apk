<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_code_artifact_card"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_code_header"
        android:paddingStart="8dp"
        android:paddingEnd="4dp">

        <!-- Claude-style reactive animated icon frame -->
        <FrameLayout
            android:id="@+id/flCardIconContainer"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_work_icon_frame"
            android:layout_marginEnd="8dp">

            <ImageView
                android:id="@+id/ivCardIcon"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_work_file_create"
                app:tint="#00E5FF"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvCardLanguage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="CODE"
            android:textColor="#E0E6ED"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tvWritingStatus"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginStart="4dp"
            android:maxWidth="56dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:background="@drawable/bg_code_writing_badge"
            android:text="✦ Writing code…"
            android:textColor="#64B5F6"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Down arrow / Tag toggle button -->
        <LinearLayout
            android:id="@+id/btnToggleMiniTerminal"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_auto_approve_chip"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:contentDescription="Show or hide the code window"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvToggleTagText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▼"
                android:textColor="#80D8FF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnCardCopy"
            android:layout_width="30dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@drawable/ic_cc_copy"
            app:tint="#90A4AE"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Copy code"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnCardExpand"
            android:layout_width="30dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="↗"
            android:textColor="#64B5F6"
            android:textSize="15sp"
            android:textStyle="bold"
            android:contentDescription="Open fullscreen viewer"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Expandable Mini Terminal / Code Window -->
    <LinearLayout
        android:id="@+id/layoutMiniTerminal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#080C14"
        android:visibility="visible">

        <!-- Mini Terminal Top Bar with macOS/Terminal dots -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#0F1420"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/bg_chat_status"
                android:backgroundTint="#FF5F56" />

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_chat_status"
                android:backgroundTint="#FFBD2E" />

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_chat_status"
                android:backgroundTint="#27C93F" />

            <TextView
                android:id="@+id/tvTerminalTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="terminal ~/workspace"
                android:textColor="#78909C"
                android:textSize="9sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutCodePreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/tvPreviewLineNumbers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#455A64"
                android:fontFamily="monospace"
                android:textSize="@dimen/chat_code_text"
                android:lineSpacingExtra="3dp"
                android:gravity="end|top"
                android:paddingEnd="10dp" />

            <TextView
                android:id="@+id/tvPreviewCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#CFD8DC"
                android:fontFamily="monospace"
                android:textSize="@dimen/chat_code_text"
                android:lineSpacingExtra="3dp"
                android:maxLines="14"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvCardBottomHint"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:gravity="center"
        android:background="#0A0E17"
        android:text="Tap tag to toggle mini window · Open ↗ for fullscreen viewer"
        android:textColor="#78909C"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.04" />

</LinearLayout>
