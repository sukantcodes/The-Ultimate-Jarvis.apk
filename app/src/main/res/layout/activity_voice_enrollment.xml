<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/themeBg"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="14dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:contentDescription="Back"
            app:tint="?attr/themeTextPrimary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VOICE BIOMETRICS"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.12"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tvHeaderBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HUD V2"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:letterSpacing="0.08"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="32dp">

            <!-- Status Banner Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatusBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="?attr/themeCardBg"
                app:cardCornerRadius="16dp"
                app:strokeColor="?attr/themeCardBorder"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/viewStatusDot"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="?attr/themeAccent" />

                        <TextView
                            android:id="@+id/tvEnrollmentStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="OWNER VOICE: NOT ENROLLED"
                            android:textColor="?attr/themeAccent"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.06" />

                        <TextView
                            android:id="@+id/tvStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="BIOMETRIC"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.06" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvStatusDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Jarvis is calibrated to your voice. Any speech or commands from strangers, family members, or TV are automatically blocked."
                        android:textColor="?attr/themeTextSecondary"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Voice Lock Toggle Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardVoiceLock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="?attr/themeCardBg"
                app:cardCornerRadius="16dp"
                app:strokeColor="?attr/themeCardBorder"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchOwnerOnly"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="Enable Voice Lock (Wake Word &amp; Screen Unlock)"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSwitchDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Require acoustic voice verification before Jarvis wakes up or unlocks protected features."
                        android:textColor="?attr/themeTextSecondary"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Multi-Sample Voice Enrollment Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEnrollment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="?attr/themeCardBg"
                app:cardCornerRadius="16dp"
                app:strokeColor="?attr/themeCardBorder"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvStepIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:text="TRAIN STEP 1 OF 3"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12" />

                    <TextView
                        android:id="@+id/tvPromptInstruction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Say clearly into your phone:"
                        android:textColor="?attr/themeTextSecondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvPromptPhrase"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="&quot;Hey Jarvis, wake up&quot;"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- Live Waveform Visualizer for Enrollment -->
                    <com.jarvis.assistant.ui.chat.VoiceWaveView
                        android:id="@+id/waveEnrollment"
                        android:layout_width="140dp"
                        android:layout_height="36dp"
                        android:layout_marginTop="12dp"
                        android:visibility="gone" />

                    <!-- Record Sample Button -->
                    <Button
                        android:id="@+id/btnRecordSample"
                        android:layout_width="wrap_content"
                        android:layout_height="56dp"
                        android:layout_marginTop="16dp"
                        android:paddingHorizontal="32dp"
                        android:text="TAP &amp; SPEAK PHRASE"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:letterSpacing="0.06"
                        app:backgroundTint="@null" />

                    <TextView
                        android:id="@+id/tvRecordFeedback"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="Tap to start recording sample 1"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="12sp" />

                    <!-- Step Indicators -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvStep1Dot"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="① Sample 1"
                            android:textColor="?attr/themeAccent"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvStep2Dot"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="② Sample 2"
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvStep3Dot"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="③ Sample 3"
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Live Verification Test Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLiveTest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="?attr/themeCardBg"
                app:cardCornerRadius="16dp"
                app:strokeColor="?attr/themeCardBorder"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LIVE VERIFICATION TEST TOOL"
                        android:textColor="?attr/themeAccent"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Test your voice or let a friend speak to verify that Jarvis accepts you and denies them."
                        android:textColor="?attr/themeTextSecondary"
                        android:textSize="12sp" />

                    <!-- Live Waveform Visualizer for Test -->
                    <com.jarvis.assistant.ui.chat.VoiceWaveView
                        android:id="@+id/waveTest"
                        android:layout_width="140dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="10dp"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btnTestVoice"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="14dp"
                        android:text="Test Voice Verification"
                        android:textColor="?attr/themeAccent"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        app:backgroundTint="@null" />

                    <!-- Test Result Banner -->
                    <LinearLayout
                        android:id="@+id/layoutTestResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvTestVerdict"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✓ Authenticated: 94% Match"
                            android:textColor="?attr/themeAccent"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTestDetails"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Cosine distance: 0.28 (Threshold: 0.70)"
                            android:textColor="?attr/themeTextSecondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Strictness / Sensitivity Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSensitivity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="?attr/themeCardBg"
                app:cardCornerRadius="16dp"
                app:strokeColor="?attr/themeCardBorder"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SENSITIVITY / STRICTNESS"
                        android:textColor="?attr/themeAccent"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />

                    <RadioGroup
                        android:id="@+id/rgSensitivity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">

                        <RadioButton
                            android:id="@+id/rbStrict"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Strict (High Security - Zero False Accepts)"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbBalanced"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="Balanced (Recommended - Optimal Everyday)"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbRelaxed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Relaxed (Forgiving - Best if you have a cold)"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="13sp" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Reset Button -->
            <Button
                android:id="@+id/btnClearProfile"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="RESET / RE-ENROLL VOICE PROFILE"
                android:textColor="?attr/themeWarning"
                android:textStyle="bold"
                android:textSize="13sp"
                app:backgroundTint="@null" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
