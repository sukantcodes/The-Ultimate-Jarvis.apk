<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootRuleEditorLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/themeBg">

    <!-- Ambient Liquid Glass Glow Fields -->
    <View
        android:id="@+id/glowOrbTopRight"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_marginTop="-60dp"
        android:layout_marginEnd="-60dp"
        android:background="?attr/themeGlowBlob1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/glowOrbBottom"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_marginBottom="-50dp"
        android:layout_marginEnd="-30dp"
        android:background="?attr/themeGlowBlob3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top App Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/desc_back"
            app:tint="?attr/themeTextPrimary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tvEditorTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="AUTOMATION RULE CREATOR"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08"
            android:gravity="center"
            android:layout_marginHorizontal="12dp"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintEnd_toStartOf="@id/btnSaveRule"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <Button
            android:id="@+id/btnSaveRule"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SAVE"
            android:textStyle="bold"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="none"
        android:paddingHorizontal="16dp"
        android:clipToPadding="false"
        android:paddingBottom="36dp"
        app:layout_constraintTop_toBottomOf="@id/appBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card 1: Rule Details -->
            <LinearLayout
                android:id="@+id/cardDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_jarvis_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RULE IDENTITY"
                    android:textColor="?attr/themeAccent"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Rule Name (e.g., Morning Briefing)"
                    app:boxBackgroundColor="?attr/themeInputBg"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRuleTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        android:maxLines="1"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Description (Optional)"
                    app:boxBackgroundColor="?attr/themeInputBg"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRuleDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        android:maxLines="2"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Card 2: Trigger Selection -->
            <LinearLayout
                android:id="@+id/cardTrigger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_jarvis_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CHOOSE TRIGGER TYPE"
                    android:textColor="?attr/themeAccent"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10" />

                <!-- Trigger Type Radios / Tabs -->
                <RadioGroup
                    android:id="@+id/rgTriggerType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <RadioButton
                        android:id="@+id/rbTriggerScheduled"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⏰ Schedule"
                        android:checked="true"
                        android:textSize="12sp"
                        android:textColor="?attr/themeTextPrimary" />

                    <RadioButton
                        android:id="@+id/rbTriggerVoice"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🎙️ Voice"
                        android:textSize="12sp"
                        android:textColor="?attr/themeTextPrimary" />

                    <RadioButton
                        android:id="@+id/rbTriggerDevice"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⚡ Device"
                        android:textSize="12sp"
                        android:textColor="?attr/themeTextPrimary" />
                </RadioGroup>

                <!-- 1. SCHEDULED TRIGGER PANEL -->
                <LinearLayout
                    android:id="@+id/panelScheduledTrigger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp">

                    <RadioGroup
                        android:id="@+id/rgScheduleType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rbDaily"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Daily"
                            android:checked="true"
                            android:textSize="12sp"
                            android:textColor="?attr/themeTextPrimary" />

                        <RadioButton
                            android:id="@+id/rbWeekdays"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Weekdays"
                            android:textSize="12sp"
                            android:layout_marginStart="16dp"
                            android:textColor="?attr/themeTextPrimary" />

                        <RadioButton
                            android:id="@+id/rbOneTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="One-time"
                            android:textSize="12sp"
                            android:layout_marginStart="16dp"
                            android:textColor="?attr/themeTextPrimary" />
                    </RadioGroup>

                    <Button
                        android:id="@+id/btnPickTime"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="⏰ Set Trigger Time: 08:00 AM"
                        android:textColor="?attr/themeAccent" />
                </LinearLayout>

                <!-- 2. VOICE TRIGGER PANEL -->
                <LinearLayout
                    android:id="@+id/panelVoiceTrigger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Trigger Phrase (English or हिन्दी)"
                        app:boxBackgroundColor="?attr/themeInputBg"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etVoicePhrase"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="नमस्ते जार्विस"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Quick Preset Chips -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Suggested phrases:"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="11sp"
                        android:layout_marginTop="8dp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:layout_marginTop="4dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/chipPhraseHindi1"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="नमस्ते जार्विस"
                                android:textSize="11sp" />

                            <Button
                                android:id="@+id/chipPhraseHindi2"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="चार्जिंग स्थिति बताओ"
                                android:textSize="11sp" />

                            <Button
                                android:id="@+id/chipPhraseEng1"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="Good morning Jarvis"
                                android:textSize="11sp" />

                            <Button
                                android:id="@+id/chipPhraseEng2"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="Good night Jarvis"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- 3. DEVICE EVENT PANEL -->
                <LinearLayout
                    android:id="@+id/panelDeviceTrigger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp"
                    android:visibility="gone">

                    <RadioGroup
                        android:id="@+id/rgDeviceEventType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <RadioButton
                            android:id="@+id/rbPowerConnected"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚡ Charger Connected (AC / USB)"
                            android:checked="true"
                            android:textSize="13sp"
                            android:textColor="?attr/themeTextPrimary" />

                        <RadioButton
                            android:id="@+id/rbPowerDisconnected"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔌 Charger Disconnected"
                            android:textSize="13sp"
                            android:textColor="?attr/themeTextPrimary" />

                        <RadioButton
                            android:id="@+id/rbBatteryLow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🪫 Battery Drops Below 20%"
                            android:textSize="13sp"
                            android:textColor="?attr/themeTextPrimary" />

                        <RadioButton
                            android:id="@+id/rbBatteryFull"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔋 Battery Reaches 100% (Full)"
                            android:textSize="13sp"
                            android:textColor="?attr/themeTextPrimary" />
                    </RadioGroup>
                </LinearLayout>
            </LinearLayout>

            <!-- Card 3: Actions Configuration -->
            <LinearLayout
                android:id="@+id/cardActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_jarvis_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ACTIONS TO EXECUTE"
                        android:textColor="?attr/themeAccent"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.10" />

                    <Button
                        android:id="@+id/btnTestActions"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TEST RUN"
                        android:textSize="11sp"
                        android:textColor="?attr/themeAccent" />
                </LinearLayout>

                <!-- Action 1: Speak Voice TTS Message -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="🔊 Speak TTS Message"
                    app:boxBackgroundColor="?attr/themeInputBg"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTtsMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Good morning Sir, all systems operational."
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Action 2: Show Notification -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="🔔 Notification Title &amp; Text"
                    app:boxBackgroundColor="?attr/themeInputBg"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNotificationText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="JARVIS Task Complete"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Action 3: Open App or Feature -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Device Hardware &amp; App Controls:"
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="12sp"
                    android:layout_marginTop="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <Button
                        android:id="@+id/btnActionFlashlight"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⚡ Flashlight"
                        android:textSize="11sp"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btnActionVolume"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🔊 Volume 80%"
                        android:textSize="11sp"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btnActionYouTube"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="▶️ YouTube"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvActiveFeatureAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selected feature: None"
                    android:textColor="?attr/themeAccent"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
