<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_study_glass_card"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvOcrTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Verify Question Before Solving"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOcrSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Check the recognized question, select if multiple appear, or edit any symbol."
            android:textColor="?attr/themeTextSecondary"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/ivOcrPreview"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_study_input_field"
            android:contentDescription="Captured question image preview"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <!-- PDF Multi-Page Navigator Row (shown for PDFs) -->
        <LinearLayout
            android:id="@+id/layoutPdfPageBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/btnPdfPrevPage"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="48dp"
                android:text="Prev"
                android:textAllCaps="false"
                android:textColor="?attr/themeTextPrimary" />

            <TextView
                android:id="@+id/tvPdfPageInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="?attr/themeAccent"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPdfNextPage"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="48dp"
                android:text="Next"
                android:textAllCaps="false"
                android:textColor="?attr/themeTextPrimary" />

            <Button
                android:id="@+id/btnPdfVisionScan"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Scan Page"
                android:textAllCaps="false"
                android:textColor="?attr/themeAccent2" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCandidatesHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Detected Questions"
            android:textColor="?attr/themeAccent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/containerOcrCandidates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Confirmed Question (Editable)"
            android:textColor="?attr/themeTextSecondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etConfirmedQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_study_input_field"
            android:gravity="top|start"
            android:hint="Edit or confirm exact question…"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="6"
            android:minHeight="84dp"
            android:padding="12dp"
            android:textColor="?attr/themeTextPrimary"
            android:textColorHint="?attr/themeTextSecondary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnOcrCancel"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_study_glass_card"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="?attr/themeTextSecondary" />

            <Button
                android:id="@+id/btnOcrSolve"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1.4"
                android:background="@drawable/bg_study_glass_pill"
                android:text="Solve on Board"
                android:textAllCaps="false"
                android:textColor="?attr/themeAccent"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
