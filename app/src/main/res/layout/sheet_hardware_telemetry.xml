<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollHardwareTelemetry"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="?attr/themeSurface"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/layoutTelemetryContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">

        <!-- Top Drag Handle -->
        <View
            android:id="@+id/viewDragHandle"
            android:layout_width="48dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:background="?attr/themeCardBorder" />

        <!-- Header Section -->
        <LinearLayout
            android:id="@+id/layoutHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CYBERNETIC TELEMETRY"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:id="@+id/tvHeaderSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Iron-Man Real-Time Hardware HUD"
                    android:textColor="?attr/themeTextSecondary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Status Pulse Badge -->
            <TextView
                android:id="@+id/tvHudStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="ONLINE"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:fontFamily="sans-serif-black" />
        </LinearLayout>

        <!-- Card 1: CPU SoC Architecture -->
        <LinearLayout
            android:id="@+id/cardCpu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_marginBottom="12dp"
            android:background="?attr/themeCardBg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:id="@+id/ivCpuIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_settings_chip"
                    app:tint="?attr/themeAccent"
                    android:layout_marginEnd="8dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/tvCpuTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="CPU SOC ARCHITECTURE"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:id="@+id/tvCpuLoadBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="0% LOAD"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCpuDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="8 Cores • 1800 MHz / 2400 MHz"
                android:textColor="?attr/themeTextSecondary"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <ProgressBar
                android:id="@+id/pbCpuLoad"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:max="100"
                android:progress="0"
                android:progressTint="?attr/themeAccent" />
        </LinearLayout>

        <!-- Card 2: Memory RAM Utilization -->
        <LinearLayout
            android:id="@+id/cardMemory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_marginBottom="12dp"
            android:background="?attr/themeCardBg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:id="@+id/ivMemoryIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_diag_memory"
                    app:tint="?attr/themeAccent2"
                    android:layout_marginEnd="8dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/tvMemoryTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SYSTEM RAM UTILIZATION"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:id="@+id/tvMemoryLoadBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="0% USED"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvMemoryDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Used: 0.0 GB • Total: 0.0 GB (0.0 GB Free)"
                android:textColor="?attr/themeTextSecondary"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <ProgressBar
                android:id="@+id/pbMemoryLoad"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:max="100"
                android:progress="0"
                android:progressTint="?attr/themeAccent2" />
        </LinearLayout>

        <!-- Card 3: Battery & Thermals -->
        <LinearLayout
            android:id="@+id/cardBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_marginBottom="12dp"
            android:background="?attr/themeCardBg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:id="@+id/ivBatteryIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_diag_battery"
                    app:tint="?attr/themeSuccess"
                    android:layout_marginEnd="8dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/tvBatteryTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="POWER &amp; THERMAL MATRIX"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:id="@+id/tvThermalStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="NOMINAL"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvBatteryDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Level: 100% • On Battery • 4,100 mV"
                android:textColor="?attr/themeTextSecondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvThermalDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Thermal Core: 31.0°C"
                android:textColor="?attr/themeTextSecondary"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <ProgressBar
                android:id="@+id/pbBatteryLevel"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:max="100"
                android:progress="0"
                android:progressTint="?attr/themeSuccess" />
        </LinearLayout>

        <!-- Card 4: Internal Storage & Network -->
        <LinearLayout
            android:id="@+id/cardStorageNetwork"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_marginBottom="16dp"
            android:background="?attr/themeCardBg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:id="@+id/ivStorageIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_diag_folder"
                    app:tint="?attr/themeAccent"
                    android:layout_marginEnd="8dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/tvStorageNetworkTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="STORAGE &amp; TELEMETRY LINK"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:id="@+id/tvNetworkBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="OFFLINE"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStorageDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Internal Flash: 0.0 GB Free of 0.0 GB"
                android:textColor="?attr/themeTextSecondary"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <ProgressBar
                android:id="@+id/pbStorageLoad"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:max="100"
                android:progress="0"
                android:progressTint="?attr/themeAccent"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvNetworkDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Active Link: Offline • Rx: 0 Kbps • Tx: 0 Kbps"
                android:textColor="?attr/themeTextSecondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Action Row -->
        <LinearLayout
            android:id="@+id/layoutActionRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Vocalize System Report Button (48dp+ min touch target) -->
            <LinearLayout
                android:id="@+id/btnVocalizeReport"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/themeCardBg">

                <ImageView
                    android:id="@+id/ivVocalizeIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_cc_volume"
                    app:tint="?attr/themeAccent"
                    android:layout_marginEnd="8dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/tvVocalizeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VOCALIZE REPORT"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:fontFamily="sans-serif-black" />
            </LinearLayout>

            <View
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <!-- Dismiss Button (48dp+ min touch target) -->
            <LinearLayout
                android:id="@+id/btnDismissHud"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/themeCardBg">

                <ImageView
                    android:id="@+id/ivDismissIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_close"
                    app:tint="?attr/themeTextSecondary"
                    android:layout_marginEnd="6dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/tvDismissText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CLOSE"
                    android:textColor="?attr/themeTextSecondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:fontFamily="sans-serif-black" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
