<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="14dp">

    <!-- Your message: a liquid-glass bubble tinted with the theme accent, on the right -->
    <LinearLayout
        android:id="@+id/layoutUserContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvUserAttachment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginBottom="6dp"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="▣  Open attachment"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Preview attached file inside JARVIS chat" />

        <TextView
            android:id="@+id/tvUserMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:textColor="?attr/themeTextPrimary"
            android:fontFamily="sans-serif"
            android:textSize="15sp"
            android:lineSpacingExtra="3dp"
            android:textIsSelectable="false" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">

            <ImageView
                android:id="@+id/btnUserEdit"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="15dp"
                android:src="@drawable/ic_cc_pencil"
                app:tint="?attr/themeTextMuted"
                android:contentDescription="Edit your message"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/btnUserCopy"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="15dp"
                android:src="@drawable/ic_cc_copy"
                app:tint="?attr/themeTextMuted"
                android:contentDescription="Copy your message"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Everything JARVIS says for this turn lives in one liquid-glass panel -->
    <com.jarvis.assistant.ui.chat.liquid.LiquidPaneLayout
        android:id="@+id/layoutAssistantGlass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:visibility="gone">

        <!-- JARVIS: a small glass orb that turns faster while the answer is being worked out -->
        <LinearLayout
            android:id="@+id/layoutAssistantHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="28dp"
                android:layout_height="28dp">

                <com.jarvis.assistant.ui.chat.liquid.LiquidOrbView
                    android:id="@+id/orbAssistant"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:importantForAccessibility="no" />

                <!-- Spark animation (thinking / writing / shimmer) replaces the orb while JARVIS is working -->
                <com.jarvis.assistant.ui.chat.SparkView
                    android:id="@+id/sparkAssistant"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:visibility="gone"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvAssistantName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/chat_label_jarvis"
                android:textColor="?attr/themeTextSecondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />
        </LinearLayout>

        <!-- Replying indicator (shown while the answer is pending) -->
        <FrameLayout
            android:id="@+id/layoutThinking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <com.jarvis.assistant.ui.chat.ThinkingIndicatorView
                android:id="@+id/thinkingIndicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </FrameLayout>

        <!-- What Jarvis is doing (or did) for this message: spinner, steps, progress. Shown inline like Claude. -->
        <com.jarvis.assistant.ui.chat.InlineActivityView
            android:id="@+id/inlineActivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- Assistant message text, code cards and the copy / read aloud / save actions -->
        <LinearLayout
            android:id="@+id/layoutAssistantContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvAssistantMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:textColor="?attr/themeTextPrimary"
                android:fontFamily="sans-serif"
                android:textSize="15sp"
                android:lineSpacingExtra="5dp"
                android:breakStrategy="high_quality"
                android:hyphenationFrequency="none"
                android:textIsSelectable="true" />

            <LinearLayout
                android:id="@+id/layoutAssistantArtifacts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutAssistantImages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <ImageView
                    android:id="@+id/btnAssistantCopy"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="15dp"
                    android:src="@drawable/ic_cc_copy"
                    app:tint="?attr/themeTextMuted"
                    android:contentDescription="Copy assistant response"
                    android:clickable="true"
                    android:focusable="true" />

                <ImageView
                    android:id="@+id/btnAssistantPlay"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="15dp"
                    android:src="@drawable/ic_cc_volume"
                    app:tint="?attr/themeTextMuted"
                    android:contentDescription="Read response aloud; tap again to stop"
                    android:clickable="true"
                    android:focusable="true" />

                <ImageView
                    android:id="@+id/btnAssistantSave"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="15dp"
                    android:src="@drawable/ic_cc_download"
                    app:tint="?attr/themeTextMuted"
                    android:contentDescription="Save response as a text file"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>

    </com.jarvis.assistant.ui.chat.liquid.LiquidPaneLayout>

</LinearLayout>
