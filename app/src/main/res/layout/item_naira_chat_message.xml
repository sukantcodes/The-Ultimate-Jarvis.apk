<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- User Message Bubble (Right Aligned) -->
    <LinearLayout
        android:id="@+id/layoutUserContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvUserAttachment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="560dp"
            android:minWidth="190dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_chat_attachment"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:text="▣  Open attachment"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Preview attached file inside JARVIS chat" />

        <TextView
            android:id="@+id/tvUserMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="560dp"
            android:background="@drawable/bg_jarvis_chat_user"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:text="Hi"
            android:textColor="?attr/colorOnPrimary"
            android:fontFamily="sans-serif"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp">

            <ImageView
                android:id="@+id/btnUserEdit"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_edit"
                app:tint="?attr/themeTextMuted"
                android:contentDescription="Edit your message"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="10dp" />

            <ImageView
                android:id="@+id/btnUserCopy"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_copy"
                app:tint="?attr/themeTextMuted"
                android:contentDescription="Copy your message"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Assistant Message Bubble (Left Aligned) -->
    <LinearLayout
        android:id="@+id/layoutAssistantContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="start"
        android:layout_marginTop="6dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✦  JARVIS AI"
            android:textColor="?attr/themeAccent"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.10"
            android:layout_marginBottom="7dp" />

        <TextView
            android:id="@+id/tvAssistantMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="18dp"
            android:maxWidth="720dp"
            android:background="@drawable/bg_jarvis_chat_assistant"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:text="Hey! I'm doing great, aap. How are you feeling today? 😊"
            android:textColor="?attr/themeTextPrimary"
            android:fontFamily="sans-serif"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"
            android:breakStrategy="high_quality"
            android:hyphenationFrequency="normal" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:layout_marginStart="4dp">

            <ImageView
                android:id="@+id/btnAssistantCopy"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_copy"
                app:tint="?attr/themeTextMuted"
                android:contentDescription="Copy assistant response"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="12dp" />

            <ImageView
                android:id="@+id/btnAssistantEdit"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_edit"
                android:contentDescription="Edit this response as an artifact"
                app:tint="?attr/themeTextMuted"
                android:layout_marginEnd="12dp" />

            <ImageView
                android:id="@+id/btnAssistantPlay"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_tts_play"
                app:tint="?attr/themeTextMuted"
                android:contentDescription="Read response aloud; tap again to stop"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/btnAssistantSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save response"
                android:textColor="?attr/themeTextSecondary"
                android:textSize="12sp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:contentDescription="Save Jarvis response as a text file" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
