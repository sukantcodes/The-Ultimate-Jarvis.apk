<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Row Header (clickable for expansion) -->
    <LinearLayout
        android:id="@+id/layoutRowHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground">

        <TextView
            android:id="@+id/tvTaskDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="?attr/themeTextSecondary"
            android:textSize="13.5sp"
            android:fontFamily="sans-serif"
            tools:text="Check external dispatcher API usage" />

        <TextView
            android:id="@+id/tvTaskStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="6dp"
            android:text="Failed"
            android:textColor="?attr/themeWarning"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:visibility="gone"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/ivTaskChevron"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="?attr/themeTextSecondary"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <!-- Inline Expanded Code Content Panel -->
    <LinearLayout
        android:id="@+id/layoutRowExpandedContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- Request block -->
        <LinearLayout
            android:id="@+id/layoutRequestBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tvRequestLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Request"
                android:textColor="?attr/themeTextMuted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:layout_marginBottom="4dp" />

            <FrameLayout
                android:id="@+id/cardRequestCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_claude_code_inset"
                android:padding="12dp">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fillViewport="true"
                    android:scrollbars="none">

                    <TextView
                        android:id="@+id/tvRequestCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="12.5sp"
                        android:lineSpacingExtra="3dp"
                        android:textIsSelectable="true"
                        tools:text="sed -n 606,622p res/layout/fragment_settings.xml" />
                </HorizontalScrollView>
            </FrameLayout>
        </LinearLayout>

        <!-- Response block -->
        <LinearLayout
            android:id="@+id/layoutResponseBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvResponseLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Response"
                android:textColor="?attr/themeTextMuted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:layout_marginBottom="4dp" />

            <FrameLayout
                android:id="@+id/cardResponseCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_claude_code_inset"
                android:padding="12dp">

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/scrollResponseCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fillViewport="true"
                    android:scrollbars="vertical">

                    <TextView
                        android:id="@+id/tvResponseCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="12.5sp"
                        android:lineSpacingExtra="3dp"
                        android:textIsSelectable="true"
                        tools:text="android:importantForAccessibility=&quot;no&quot;" />
                </androidx.core.widget.NestedScrollView>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Row Divider (full width) -->
    <View
        android:id="@+id/viewRowDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/themeCardBorder" />

</LinearLayout>
