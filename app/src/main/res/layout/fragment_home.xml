<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/themeBg"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="96dp">

    <!-- The upper 65% is reserved for the main orb; the lower 35% holds Home controls. -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/orbAreaEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.65" />

    <FrameLayout
        android:id="@+id/orbContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/orbAreaEnd"
        app:layout_constraintHeight_default="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/orbHaloRing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="@drawable/bg_jarvis_orb_halo" />

        <WebView
            android:id="@+id/orbWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="@android:color/transparent" />
    </FrameLayout>

    <!-- Top Action Bar -->
    <ImageButton
        android:id="@+id/btnTopChat"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_jarvis_icon_square"
        android:src="@drawable/ic_chat_bubble"
        app:tint="?attr/themeTextPrimary"
        android:contentDescription="Chat"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/layoutTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="@id/btnTopChat"
        app:layout_constraintBottom_toBottomOf="@id/btnTopChat"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivHeaderJarvisLogo"
            android:layout_width="116dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_jarvis_logo"
            android:scaleType="fitCenter"
            android:contentDescription="Jarvis Logo" />

        <TextView
            android:id="@+id/tvGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome, Sukant"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="14sp"
            android:letterSpacing="0.03"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnTopSettings"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="@drawable/bg_jarvis_icon_square"
        android:src="@drawable/ic_menu"
        app:tint="?attr/themeTextPrimary"
        android:contentDescription="Open navigation menu"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Center 3D Glowing Particle Orb Stage -->


    <!-- Sleek Futuristic Status Pill -->
    <LinearLayout
        android:id="@+id/layoutStatusIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        app:layout_constraintTop_toTopOf="@id/orbAreaEnd"
        app:layout_constraintBottom_toTopOf="@id/cardWeather"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_jarvis_status_badge"
            android:elevation="4dp"
            android:paddingHorizontal="18dp"
            android:paddingVertical="9dp">

            <View
                android:id="@+id/dotStatusGlow"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_jarvis_mic_center"
                android:backgroundTint="?attr/themeAccent" />

            <TextView
                android:id="@+id/tvListeningStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TAP ORB TO START"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="12sp"
                android:letterSpacing="0.10"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvHoldHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hold button or orb to power off"
            android:textColor="?attr/themeTextMuted"
            android:textSize="10sp"
            android:fontFamily="sans-serif"
            android:layout_marginTop="5dp" />
    </LinearLayout>

    <!-- Weather Widget Card -->
    <LinearLayout
        android:id="@+id/cardWeather"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_home_card_premium"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clickable="true"
        android:focusable="true"
        android:minHeight="58dp"
        android:layout_marginBottom="6dp"
        app:layout_constraintBottom_toTopOf="@id/homeLaunchpad"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvTemperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--°C"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="32sp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="-0.02"
            android:includeFontPadding="false"
            android:layout_marginEnd="16dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvWeatherCondition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detecting Location&#8230;"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tvWeatherDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap to refresh live atmosphere"
                android:textColor="?attr/themeTextMuted"
                android:textSize="12sp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivWeatherIcon"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:padding="11dp"
            android:background="@drawable/bg_home_badge_accent"
            android:src="@drawable/ic_weather_sun"
            app:tint="?attr/themeAccent"
            android:contentDescription="Weather"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Home Launchpad: fast access to major JARVIS experiences -->
    <HorizontalScrollView
        android:id="@+id/homeLaunchpad"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginBottom="6dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/layoutActionGrid"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnHomeAutomation"
                android:layout_width="126dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_home_card_premium"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:contentDescription="Open Automation Studio">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:padding="7dp"
                    android:background="@drawable/bg_home_badge_cyan"
                    android:src="@drawable/ic_settings_automation"
                    app:tint="#39C6FF"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Automation"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Build tasks"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-light"
                        android:maxLines="1" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnHomeOffline"
                android:layout_width="126dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_home_card_premium"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:contentDescription="Open Offline JARVIS">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:padding="7dp"
                    android:background="@drawable/bg_home_badge_green"
                    android:src="@drawable/ic_sparkle"
                    app:tint="#34D399"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Offline AI"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Local assistant"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-light"
                        android:maxLines="1" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnHomeMaya"
                android:layout_width="126dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_home_card_premium"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:contentDescription="Open Maya companion settings">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:padding="7dp"
                    android:background="@drawable/bg_home_badge_pink"
                    android:src="@drawable/ic_sparkle"
                    app:tint="#F472B6"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Maya Mode"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Companion"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-light"
                        android:maxLines="1" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Quick Action Grid (3 Modern High-Tech Cards) -->
    <LinearLayout
        android:id="@+id/layoutActionGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 1. Screen Share -->
        <LinearLayout
            android:id="@+id/btnScreenShareQuick"
            android:layout_width="0dp"
            android:layout_height="66dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/bg_home_card_premium"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Start or stop screen sharing">

            <ImageView
                android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:padding="7dp"
                    android:background="@drawable/bg_home_badge_violet"
                android:src="@drawable/ic_screen_share"
                    app:tint="#A78BFA"
                android:layout_marginBottom="2dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Screen"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tvQuickScreenShareStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Share"
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 2. Saved Memories -->
        <LinearLayout
            android:id="@+id/btnSavedMemories"
            android:layout_width="0dp"
            android:layout_height="66dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/bg_home_card_premium"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Open saved memories">

            <ImageView
                android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:padding="7dp"
                    android:background="@drawable/bg_home_badge_amber"
                android:src="@drawable/ic_stack_memory"
                    app:tint="#FFB020"
                android:layout_marginBottom="2dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Memories"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recall Core"
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3. Conversation Language -->
        <LinearLayout
            android:id="@+id/btnConversationLanguageQuick"
            android:layout_width="0dp"
            android:layout_height="66dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_home_card_premium"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Change conversation language">

            <ImageView
                android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:padding="7dp"
                    android:background="@drawable/bg_home_badge_orange"
                android:src="@drawable/ic_settings_language"
                    app:tint="#FB923C"
                android:layout_marginBottom="2dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Language"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tvQuickLanguageStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto"
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- Prominent Actionable Error Card Overlay (Floats Upon Orb) -->
    <LinearLayout
        android:id="@+id/cardLiveError"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_jarvis_error_card"
        android:padding="20dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:elevation="32dp"
        android:translationZ="32dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/orbContainer"
        app:layout_constraintBottom_toBottomOf="@id/orbContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivLiveErrorIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_warning"
                app:tint="#EF4444" />

            <TextView
                android:id="@+id/tvLiveErrorTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="API KEY ERROR"
                android:textColor="#EF4444"
                android:textSize="14sp"
                android:letterSpacing="0.08"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnDismissLiveError"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                app:tint="?attr/themeTextMuted"
                android:contentDescription="Dismiss" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLiveErrorMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Google rejected the API key: 400 Bad Request. Please update your API key in Settings."
            android:textColor="?attr/themeTextPrimary"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp" />

        <Button
            android:id="@+id/btnFixLiveError"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="14dp"
            android:paddingHorizontal="20dp"
            android:text="OPEN API SETTINGS"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_jarvis_pill_button"
            app:backgroundTint="@null"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
