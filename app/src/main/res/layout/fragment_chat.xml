<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/themeBg">

    <!-- 1. TOP FIXED TOOLBAR — EXACT CLAUDE MOBILE REPLICATION -->
    <LinearLayout
        android:id="@+id/layoutChatHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/themeCardBg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="12dp">

            <!-- 1. Sidebar/task-navigation icon -->
            <ImageButton
                android:id="@+id/btnChatMenu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="11dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_sidebar"
                app:tint="?attr/themeTextSecondary"
                android:contentDescription="Open navigation drawer" />

            <!-- 2. Task title with truncated text & 3. Small downward arrow beside title -->
            <LinearLayout
                android:id="@+id/layoutTitleDropdown"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="6dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    android:id="@+id/tvChatTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="130dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="Jarvis"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="14.5sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/ivTitleDropdown"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="?attr/themeTextSecondary"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- 4. Checklist/list icon & 5. Step indicator (e.g. "Step 2 of 5") -->
            <LinearLayout
                android:id="@+id/layoutTaskStepIndicator"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/ivChecklistIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_checklist_bullet"
                    app:tint="?attr/themeTextSecondary"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/tvTaskStepIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="Step 1 of 1"
                    android:textColor="?attr/themeTextSecondary"
                    android:textSize="12.5sp"
                    android:fontFamily="sans-serif"
                    android:maxLines="1" />
            </LinearLayout>

            <!-- 6. Share icon and Share label -->
            <LinearLayout
                android:id="@+id/layoutShare"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="8dp"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="Share or export conversation">

                <ImageView
                    android:id="@+id/ivShareIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_share_tray"
                    app:tint="?attr/themeTextPrimary"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/tvShareLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="Share"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </LinearLayout>

        <!-- Thin subtle bottom separator -->
        <View
            android:id="@+id/viewHeaderDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/themeCardBorder" />

        <!-- Hidden legacy views preserved for full backward compatibility & zero crashes -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone">
            <TextView android:id="@+id/tvChatSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/tvProviderModel" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <LinearLayout android:id="@+id/layoutWorkProgress" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <ProgressBar android:id="@+id/pbWorkProgress" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvWorkProgressPercent" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <TextView android:id="@+id/tvChatTokens" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/tvHardwareTelemetry" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <ImageButton android:id="@+id/btnVoiceSpeaker" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/tvChatStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <ImageButton android:id="@+id/btnChatNew" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/btnChatTools" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <ImageButton android:id="@+id/btnCamera" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2. SCROLLABLE CENTRAL CONVERSATION & TASK AREA -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatMessages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintWidth_max="@dimen/chat_content_max_width"
        android:clipToPadding="false"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintTop_toBottomOf="@id/layoutChatHeader"
        app:layout_constraintBottom_toTopOf="@id/cardInputContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Welcome screen when conversation has no messages -->
    <LinearLayout
        android:id="@+id/layoutChatWelcome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="@id/rvChatMessages"
        app:layout_constraintBottom_toBottomOf="@id/rvChatMessages"
        app:layout_constraintStart_toStartOf="@id/rvChatMessages"
        app:layout_constraintEnd_toEndOf="@id/rvChatMessages">

        <TextView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:gravity="center"
            android:background="@drawable/bg_chat_orb"
            android:text="J"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="36sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="What can I help you with?"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Ask anything, explore an idea, or attach a file for a deeper analysis."
            android:textColor="?attr/themeTextMuted"
            android:textSize="13sp"
            android:gravity="center"
            android:lineSpacingExtra="3dp" />

        <TextView
            android:id="@+id/chipSuggestionExplain"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_chat_suggestion"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="✦  Explain a topic in simple steps"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/chipSuggestionWrite"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_chat_suggestion"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="✧  Help me write or improve something"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/chipSuggestionAnalyze"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_chat_suggestion"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="⌁  Analyze a document or code file"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Hidden compatibility view for rvWorkSteps if referenced before ConcatAdapter bind -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvWorkSteps"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 3. FIXED BOTTOM CHAT COMPOSER — EXACT CLAUDE MOBILE REPLICATION -->
    <LinearLayout
        android:id="@+id/cardInputContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintWidth_max="@dimen/chat_content_max_width"
        android:orientation="vertical"
        android:background="?attr/themeBg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Attachment Preview Bar (shown when file is selected) -->
        <LinearLayout
            android:id="@+id/layoutAttachmentPreview"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_chat_attachment"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="6dp"
            android:visibility="gone">

            <TextView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:text="📎"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvAttachmentName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:text="document.pdf"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="middle" />

            <ImageButton
                android:id="@+id/btnRemoveAttachment"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                app:tint="?attr/themeTextSecondary"
                android:contentDescription="Remove attachment" />
        </LinearLayout>

        <!-- Voice listening visualizer bar -->
        <LinearLayout
            android:id="@+id/layoutVoiceListening"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_voice_listening_bar"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_marginBottom="6dp"
            android:visibility="gone">

            <com.jarvis.assistant.ui.chat.VoiceWaveView
                android:id="@+id/voiceWaveView"
                android:layout_width="38dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvVoiceTranscript"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Listening… speak now"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:ellipsize="end" />

            <ImageButton
                android:id="@+id/btnVoiceStopAndSend"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_cc_send"
                android:src="@drawable/ic_cc_arrow_up"
                app:tint="?attr/themeTextPrimary"
                android:padding="6dp"
                android:layout_marginStart="8dp"
                android:contentDescription="Finish and send voice message" />

            <ImageButton
                android:id="@+id/btnVoiceCancel"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                app:tint="?attr/themeTextSecondary"
                android:padding="6dp"
                android:layout_marginStart="6dp"
                android:contentDescription="Cancel voice recording" />
        </LinearLayout>

        <!-- Claude Pill Input Container -->
        <LinearLayout
            android:id="@+id/layoutClaudeInputBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_claude_composer_input"
            android:paddingStart="18dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <EditText
                android:id="@+id/etMessageInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Reply"
                android:textColorHint="?attr/themeTextMuted"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="15sp"
                android:fontFamily="sans-serif"
                android:background="@null"
                android:minLines="1"
                android:maxLines="5"
                android:inputType="textCapSentences|textMultiLine"
                android:imeOptions="actionSend"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />

            <!-- Stop generation square button (visible during streaming) -->
            <ImageButton
                android:id="@+id/btnStopChat"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_stop_white_square"
                app:tint="?attr/themeTextPrimary"
                android:visibility="gone"
                android:contentDescription="Stop response" />

            <!-- Send button (arrow up) -->
            <ImageButton
                android:id="@+id/btnSendMessage"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="7dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_cc_arrow_up"
                app:tint="?attr/themeAccent"
                android:contentDescription="Send message" />
        </LinearLayout>

        <!-- Claude Bottom Action Toolbar -->
        <LinearLayout
            android:id="@+id/layoutClaudeBottomBar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">

            <!-- Plus attachment button -->
            <ImageButton
                android:id="@+id/btnAttach"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="11dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_plus"
                app:tint="?attr/themeTextSecondary"
                android:contentDescription="Attach photo, image, or document" />

            <!-- Microphone with small dropdown chevron -->
            <LinearLayout
                android:id="@+id/layoutVoiceInputCluster"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:paddingEnd="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Voice to text input">

                <ImageView
                    android:id="@+id/btnVoiceInput"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_mic_jarvis"
                    app:tint="?attr/themeTextSecondary"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/ivVoiceDropdown"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="2dp"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="?attr/themeTextSecondary"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Model selector (displays actual active Jarvis model) -->
            <TextView
                android:id="@+id/tvModelSelector"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Gemini 2.5 Flash"
                android:textColor="?attr/themeTextSecondary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="Change AI Model" />

            <!-- Mode selector (e.g. "Manual" / "Auto") -->
            <TextView
                android:id="@+id/tvModeSelector"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginStart="6dp"
                android:text="Manual"
                android:textColor="?attr/themeTextSecondary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="Change Execution Mode" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
