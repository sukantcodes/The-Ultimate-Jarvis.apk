<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/themeBg"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="96dp">

    <ImageButton
        android:id="@+id/btnChatMenu"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_jarvis_icon_square"
        android:src="@drawable/ic_menu"
        app:tint="?attr/themeTextPrimary"
        android:contentDescription="Open navigation"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/layoutChatHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintTop_toTopOf="@id/btnChatMenu"
        app:layout_constraintBottom_toBottomOf="@id/btnChatMenu"
        app:layout_constraintStart_toEndOf="@id/btnChatMenu"
        app:layout_constraintEnd_toStartOf="@id/btnChatNew">

        <TextView
            android:id="@+id/tvChatTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JARVIS"
            android:letterSpacing="0.10"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tvChatSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your AI workspace"
            android:textColor="?attr/themeTextMuted"
            android:textSize="11sp"
            android:fontFamily="sans-serif" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnChatNew"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_jarvis_icon_square"
        android:src="@drawable/ic_plus"
        app:tint="?attr/themeTextPrimary"
        android:contentDescription="Start new conversation"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatMessages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="16dp"
        android:paddingBottom="14dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintTop_toBottomOf="@id/layoutChatHeader"
        app:layout_constraintBottom_toTopOf="@id/cardInputContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/cardInputContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_jarvis_card"
        android:elevation="5dp"
        android:paddingStart="14dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/etMessageInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Message JARVIS…"
            android:textColorHint="?attr/themeTextMuted"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="15sp"
            android:fontFamily="sans-serif"
            android:background="@null"
            android:minLines="1"
            android:maxLines="5"
            android:inputType="textCapSentences|textMultiLine"
            android:paddingTop="2dp"
            android:paddingBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/chipPersona"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_jarvis_chip"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:layout_marginEnd="7dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_nav_chat"
                    app:tint="?attr/themeTextSecondary"
                    android:layout_marginEnd="5dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jarvis"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chipMode"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_jarvis_chip"
                android:paddingStart="10dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_code_chip"
                    app:tint="?attr/themeTextSecondary"
                    android:layout_marginEnd="5dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnAttach"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@null"
                android:src="@drawable/ic_plus"
                app:tint="?attr/themeTextSecondary"
                android:layout_marginEnd="6dp"
                android:contentDescription="Attach a file" />

            <ImageButton
                android:id="@+id/btnSendMessage"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_jarvis_pill_button"
                android:src="@drawable/ic_send_up"
                app:tint="#FFFFFF"
                android:contentDescription="Send message" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
