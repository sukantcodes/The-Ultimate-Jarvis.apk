<?xml version="1.0" encoding="utf-8"?>
<!-- Settings screen: About. Standalone layout, hosted by its own Activity (not nested in a parent settings layout). -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screenRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/themeBg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_jarvis_icon_square"
            android:contentDescription="Back"
            android:src="@drawable/ic_back"
            app:tint="?attr/themeTextPrimary" />

        <TextView
            android:id="@+id/tvScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:text="@string/set_section_about"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/screenScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/glassCardAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <LinearLayout
                    android:id="@+id/rowPrivacyPolicy"
                    style="@style/Widget.JarvisSettings.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <FrameLayout
                        style="@style/Widget.JarvisSettings.IconBox"
                        android:layout_width="40dp"
                        android:layout_height="40dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_settings_lock"
                            app:tint="@color/set_accent_about" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.JarvisSettings.RowTitle.About"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/set_privacypolicy_title" />

                        <TextView
                            style="@style/Widget.JarvisSettings.RowSubtitle.About"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/set_privacypolicy_subtitle" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="?attr/themeTextMuted" />
                </LinearLayout>

                <View
                    style="@style/Widget.JarvisSettings.Divider.About"
                    android:layout_width="match_parent"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:id="@+id/rowAppIdentity"
                    style="@style/Widget.JarvisSettings.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <FrameLayout
                        style="@style/Widget.JarvisSettings.IconBox"
                        android:layout_width="40dp"
                        android:layout_height="40dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_verified_badge"
                            app:tint="@color/set_accent_about" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.JarvisSettings.RowTitle.About"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/set_appidentity_title" />

                        <TextView
                            style="@style/Widget.JarvisSettings.RowSubtitle.About"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/set_appidentity_subtitle" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="?attr/themeTextMuted" />
                </LinearLayout>
            </LinearLayout>

            <!-- Social Community Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <ImageButton
                    android:id="@+id/btnSocialTelegram"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_jarvis_icon_square"
                    android:src="@drawable/ic_social_telegram"
                    app:tint="?attr/themeAccent"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="Telegram" />

                <ImageButton
                    android:id="@+id/btnSocialInstagram"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_jarvis_icon_square"
                    android:src="@drawable/ic_social_instagram"
                    app:tint="?attr/themeAccent"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="Instagram" />

                <ImageButton
                    android:id="@+id/btnSocialYoutube"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_jarvis_icon_square"
                    android:src="@drawable/ic_social_youtube"
                    app:tint="?attr/themeAccent"
                    android:contentDescription="YouTube" />
            </LinearLayout>

            <!-- Footer: Executive Signature -->
            <TextView
                android:id="@+id/tvFooterCredit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_footer_credit"
                android:textColor="?attr/themeTextMuted"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="4dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tvSettingsNoResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:padding="20dp"
                android:gravity="center"
                android:text="@string/set_search_empty"
                android:textColor="?attr/themeTextMuted"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
