<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/ttsContentRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="40dp">

        <!-- Top Navigation Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                app:tint="?attr/themeAccent"
                android:contentDescription="Back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:id="@+id/tvScreenTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NEURAL VOICE CORE"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvScreenSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Studio-Grade On-Device &amp; Dual-Tier Speech"
                    android:textColor="?attr/themeTextSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvEngineBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="★ LOCAL CORE"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="?attr/themeTextPrimary"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </LinearLayout>

        <!-- Central Holographic Audio Visualizer HUD Container -->
        <LinearLayout
            android:id="@+id/containerVisualizerCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="18dp"
            android:layout_marginBottom="20dp">

            <com.jarvis.assistant.ui.settings.tts.HolographicVisualizerView
                android:id="@+id/visualizerOrb"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center" />

            <TextView
                android:id="@+id/tvVisualizerStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STANDBY · TAP TEST TO INITIALIZE"
                android:textColor="?attr/themeAccent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/tvVisualizerSpeakerInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="bm_george · Classic Jarvis (British Male)"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Section: Synthesis Engine Selector -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NEURAL SYNTHESIS ENGINE"
            android:textColor="?attr/themeTextSecondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="10dp" />

        <!-- Engine Cards Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="18dp">

            <!-- Kokoro-82M Card -->
            <LinearLayout
                android:id="@+id/cardEngineKokoro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kokoro-82M Int8"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/badgeKokoroDefault"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PRIMARY LOCAL"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Human-level conversational flow · Multi-lang ~135 MB RAM"
                        android:textColor="?attr/themeTextSecondary"
                        android:textSize="12sp"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvRadioKokoro"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:gravity="center"
                    android:text="●"
                    android:textColor="?attr/themeAccent"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Piper VITS Card -->
            <LinearLayout
                android:id="@+id/cardEnginePiper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Piper VITS (Alan Medium)"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ultra-lightweight fallback · &lt; 50 MB RAM · 20ms latency"
                        android:textColor="?attr/themeTextSecondary"
                        android:textSize="12sp"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvRadioPiper"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:gravity="center"
                    android:text="○"
                    android:textColor="?attr/themeTextSecondary"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Gemini Cloud Card -->
            <LinearLayout
                android:id="@+id/cardEngineGemini"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gemini 3.8 Flash Cloud TTS"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Google AI Studio · Charon, Orus, Kore, Puck voices"
                        android:textColor="?attr/themeTextSecondary"
                        android:textSize="12sp"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvRadioGemini"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:gravity="center"
                    android:text="○"
                    android:textColor="?attr/themeTextSecondary"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- ElevenLabs Cloud Card -->
            <LinearLayout
                android:id="@+id/cardEngineEleven"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ElevenLabs Turbo v2.5"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ultra-low latency streaming · Rachel, Adam voices"
                        android:textColor="?attr/themeTextSecondary"
                        android:textSize="12sp"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvRadioEleven"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:gravity="center"
                    android:text="○"
                    android:textColor="?attr/themeTextSecondary"
                    android:textSize="18sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Dynamic Model Deployment Card (Local Kokoro / Piper) -->
        <LinearLayout
            android:id="@+id/cardModelDeploy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvDeployStatusTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="NEURAL MODEL CORE DEPLOYMENT"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/tvDeployStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UNINSTALLED"
                    android:textColor="?attr/themeTextSecondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDeployDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Model weight: ~140 MB archive · Memory: &lt; 150 MB RAM · Safe for 1 GB RAM devices."
                android:textColor="?attr/themeTextSecondary"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />

            <!-- Downloading Progress Container -->
            <LinearLayout
                android:id="@+id/containerDownloading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/pbModelDownload"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="?attr/themeAccent" />

                <TextView
                    android:id="@+id/tvDownloadProgressDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Streaming neural weights... 0%"
                    android:textColor="?attr/themeTextSecondary"
                    android:textSize="11sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- Deploy Action Button -->
            <Button
                android:id="@+id/btnDeployModel"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Deploy Neural Core"
                android:textColor="?attr/themeTextPrimary"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginTop="12dp" />

        </LinearLayout>

        <!-- Speaker Profiles Grid Container (Visible when Ready) -->
        <LinearLayout
            android:id="@+id/containerSpeakerSelection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CURATED SPEAKER PROFILES"
                android:textColor="?attr/themeTextSecondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="10dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupSpeakers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                android:layout_marginBottom="12dp" />

            <!-- Selected Speaker Persona Card -->
            <LinearLayout
                android:id="@+id/cardSpeakerDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:id="@+id/tvSpeakerDetailName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="bm_george · Classic Jarvis"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSpeakerDetailTone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tone: Authoritative, Formal, British Cadence · Gender: Male"
                    android:textColor="?attr/themeTextSecondary"
                    android:textSize="12sp"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <!-- Speech Cadence & Speed Slider -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SPEECH CADENCE &amp; PACE"
                android:textColor="?attr/themeTextSecondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.8x"
                    android:textColor="?attr/themeTextSecondary"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/sbSpeed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="14"
                    android:progress="5"
                    android:progressTint="?attr/themeAccent"
                    android:thumbTint="?attr/themeAccent" />

                <TextView
                    android:id="@+id/tvSpeedValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.05x"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <!-- Action Buttons: Immediate Voice Validation & Save -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTestVoice"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Test Voice"
                android:textColor="?attr/themeTextPrimary"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnSaveAndActivate"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Save &amp; Activate"
                android:textColor="?attr/themeTextPrimary"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Deactivate Offline TTS Action Button -->
        <Button
            android:id="@+id/btnDeactivateTts"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Deactivate Offline TTS"
            android:textColor="?attr/themeTextPrimary"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>