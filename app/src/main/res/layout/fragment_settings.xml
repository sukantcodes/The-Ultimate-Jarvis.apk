<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/themeBg">

    <!-- The scene behind every glass pane: the panes zoom and refract it. -->
    <com.jarvis.assistant.ui.glass.GlassBackdropView
        android:id="@+id/glassBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="100dp">

    <!-- Header deck: overline, large title, search pill and the category rail -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSettingsOverline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jarvis_sans_medium"
                    android:letterSpacing="0.24"
                    android:text="@string/set_overline"
                    android:textAllCaps="true"
                    android:textColor="?attr/themeAccent"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSettingsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/jarvis_serif_semibold"
                    android:letterSpacing="-0.04"
                    android:text="@string/set_screen_title"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSettingsSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/jarvis_sans"
                    android:letterSpacing="0.01"
                    android:text="@string/set_screen_subtitle"
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="14sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/orbBadge"
                android:layout_width="46dp"
                android:layout_height="46dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_sparkle"
                    app:tint="?attr/themeAccent" />
            </FrameLayout>
        </LinearLayout>

        <!-- Search pill + background picker -->
        <LinearLayout
            android:id="@+id/searchRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.jarvis.assistant.ui.glass.LiquidGlassLayout
                android:id="@+id/glassSearch"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                app:lgCornerRadius="24dp"
                app:lgBezel="20"
                app:lgRefraction="14"
                app:lgVeil="0.08"
                app:lgSource="@id/glassBackdrop"
                app:lgPlainBackground="@drawable/bg_lg_card"
                app:lgPlainElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="6dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_search_deck"
                        app:tint="?attr/themeTextMuted" />

                    <EditText
                        android:id="@+id/etSettingsSearch"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/set_search_hint"
                        android:imeOptions="actionSearch"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="?attr/themeTextPrimary"
                        android:textColorHint="?attr/themeTextMuted"
                        android:textSize="15sp" />

                    <ImageButton
                        android:id="@+id/btnSearchClear"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/set_search_clear"
                        android:padding="11dp"
                        android:src="@drawable/ic_close"
                        android:visibility="gone"
                        app:tint="?attr/themeTextMuted" />
                </LinearLayout>
            </com.jarvis.assistant.ui.glass.LiquidGlassLayout>

            <com.jarvis.assistant.ui.glass.LiquidGlassLayout
                android:id="@+id/glassSceneButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                app:lgCornerRadius="24dp"
                app:lgBezel="20"
                app:lgRefraction="14"
                app:lgVeil="0.08"
                app:lgSource="@id/glassBackdrop"
                app:lgPlainBackground="@drawable/bg_lg_card"
                app:lgPlainElevation="0dp">

                <ImageButton
                    android:id="@+id/btnSceneStyle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/set_scene_button"
                    android:padding="13dp"
                    android:src="@drawable/ic_sparkle"
                    app:tint="?attr/themeAccent" />
            </com.jarvis.assistant.ui.glass.LiquidGlassLayout>
        </LinearLayout>

    </LinearLayout>

    <ScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader">

        <LinearLayout
            android:id="@+id/settingsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="32dp">

            <!-- Search results (shown only while something is typed) -->
            <LinearLayout
                android:id="@+id/searchResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- Identity deck: gradient-ringed photo, name, role and quick status chips -->
            <com.jarvis.assistant.ui.glass.LiquidGlassLayout
                android:id="@+id/glassProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="22dp"
                app:lgCornerRadius="28dp"
                app:lgBezel="22"
                app:lgRefraction="16"
                app:lgVeil="0.08"
                app:lgSource="@id/glassBackdrop"
                app:lgPlainBackground="@drawable/bg_lg_card"
                app:lgPlainElevation="0dp">
            <LinearLayout
                android:id="@+id/cardProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/frameProfileRing"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:padding="3dp">

                        <ImageView
                            android:id="@+id/ivProfileAvatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_profile_photo_round"
                            android:clipToOutline="true"
                            android:contentDescription="Profile photo. Tap to choose from gallery."
                            android:padding="16dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_user_profile"
                            app:tint="?attr/themeAccent" />

                        <!-- Online status dot: filled and ringed in code so it sits cleanly on the photo's edge -->
                        <View
                            android:id="@+id/viewProfileOnlineDot"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="bottom|end" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvProfileName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/jarvis_sans_medium"
                            android:includeFontPadding="false"
                            android:letterSpacing="-0.02"
                            android:maxLines="1"
                            android:text="Sukant"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvProfileSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/jarvis_sans_medium"
                            android:includeFontPadding="false"
                            android:letterSpacing="0.1"
                            android:maxLines="1"
                            android:text="JARVIS OPERATOR • PRIMARY USER"
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/btnProfileEditTile"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="Edit name">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_edit"
                            app:tint="?attr/themeAccent" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Hairline between identity and status -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:alpha="0.8"
                    android:background="?attr/themeCardBorder" />

                <!-- Profile Quick Status Chips -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:overScrollMode="never"
                    android:scrollbars="none">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Voice Biometrics Chip -->
                    <LinearLayout
                        android:id="@+id/chipProfileVoiceStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_jarvis_status_badge_green"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:layout_marginEnd="8dp">

                        <ImageView
                            android:id="@+id/ivProfileVoiceBadgeIcon"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_verified_badge"
                            app:tint="@color/status_green"
        android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/tvProfileVoiceStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VOICE ENROLLED"
                            android:textColor="@color/status_green"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/jarvis_sans_medium"
                            android:letterSpacing="0.05"
                            android:layout_marginStart="5dp" />
                    </LinearLayout>

                    <!-- Persona Chip -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_jarvis_status_badge"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_settings_voice"
                            app:tint="?attr/themeAccent"
        android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/tvProfilePersonaChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="JARVIS PRO"
                            android:textColor="?attr/themeAccent"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/jarvis_sans_medium"
                            android:letterSpacing="0.05"
                            android:layout_marginStart="5dp" />
                    </LinearLayout>

                    <!-- Device Network role chip -->
                    <LinearLayout
                        android:id="@+id/chipProfileNetwork"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp">

                        <View
                            android:id="@+id/viewProfileNetworkDot"
                            android:layout_width="7dp"
                            android:layout_height="7dp" />

                        <TextView
                            android:id="@+id/tvProfileNetwork"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="@font/jarvis_sans_medium"
                            android:letterSpacing="0.05"
                            android:text="NETWORK"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>
            </com.jarvis.assistant.ui.glass.LiquidGlassLayout>

            <com.jarvis.assistant.ui.glass.LiquidGlassLayout
                android:id="@+id/glassCatAi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
                app:lgCornerRadius="28dp"
                app:lgBezel="22"
                app:lgRefraction="16"
                app:lgVeil="0.08"
                app:lgSource="@id/glassBackdrop"
                app:lgPlainBackground="@drawable/bg_lg_card"
                app:lgPlainElevation="0dp">
            <LinearLayout
                android:id="@+id/rowCatAi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="68dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_settings_chip"
                        app:tint="@color/set_accent_ai" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/jarvis_sans_medium"
                    android:text="@string/set_section_ai"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="?attr/themeTextMuted" />
            </LinearLayout>
            </com.jarvis.assistant.ui.glass.LiquidGlassLayout>

            <com.jarvis.assistant.ui.glass.LiquidGlassLayout
                android:id="@+id/glassCatVoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
                app:lgCornerRadius="28dp"
                app:lgBezel="22"
                app:lgRefraction="16"
                app:lgVeil="0.08"
                app:lgSource="@id/glassBackdrop"
                app:lgPlainBackground="@drawable/bg_lg_card"
                app:lgPlainElevation="0dp">
            <LinearLayout
                android:id="@+id/rowCatVoice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="68dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_settings_voice"
                        app:tint="@color/set_accent_voice" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/jarvis_sans_medium"
                    android:text="@string/set_section_voice"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="?attr/themeTextMuted" />
            </LinearLayout>
            </com.jarvis.assistant.ui.glass.LiquidGlassLayout>

            <com.jarvis.assistant.ui.glass.LiquidGlassLayout
                android:id="@+id/glassCatSecurity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
                app:lgCornerRadius="28dp"
                app:lgBezel="22"
                app:lgRefraction="16"
                app:lgVeil="0.08"
                app:lgSource="@id/glassBackdrop"
                app:lgPlainBackground="@drawable/bg_lg_card"
                app:lgPlainElevation="0dp">
            <LinearLayout
                android:id="@+id/rowCatSecurity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="68dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_settings_owner_voice"
                        app:tint="@color/set_accent_security" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/jarvis_sans_medium"
                    android:text="@string/set_section_security"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="?attr/themeTextMuted" />
            </LinearLayout>
            </com.jarvis.assistant.ui.glass.LiquidGlassLayout>

            <com.jarvis.assistant.ui.glass.LiquidGlassLayout
                android:id="@+id/glassCatAlerts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
                app:lgCornerRadius="28dp"
                app:lgBezel="22"
                app:lgRefraction="16"
                app:lgVeil="0.08"
                app:lgSource="@id/glassBackdrop"
                app:lgPlainBackground="@drawable/bg_lg_card"
                app:lgPlainElevation="0dp">
            <LinearLayout
                android:id="@+id/rowCatAlerts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="68dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_nav_bell"
                        app:tint="@color/set_accent_alerts" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/jarvis_sans_medium"
                    android:text="@string/set_section_alerts"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="?attr/themeTextMuted" />
            </LinearLayout>
            </com.jarvis.assistant.ui.glass.LiquidGlassLayout>

            <com.jarvis.assistant.ui.glass.LiquidGlassLayout
                android:id="@+id/glassCatMemory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
                app:lgCornerRadius="28dp"
                app:lgBezel="22"
                app:lgRefraction="16"
                app:lgVeil="0.08"
                app:lgSource="@id/glassBackdrop"
                app:lgPlainBackground="@drawable/bg_lg_card"
                app:lgPlainElevation="0dp">
            <LinearLayout
                android:id="@+id/rowCatMemory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="68dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_settings_db"
                        app:tint="@color/set_accent_memory" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/jarvis_sans_medium"
                    android:text="@string/set_section_memory"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_arrow_right"
