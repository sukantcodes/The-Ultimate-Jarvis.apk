<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="168dp"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:layout_marginTop="14dp"
    android:layout_marginBottom="6dp"
    android:orientation="vertical"
    android:gravity="bottom"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="18dp"
    android:paddingBottom="22dp"
    android:background="@drawable/bg_drawer_header_glass">
    <ImageView
        android:id="@+id/ivDrawerLogo"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:padding="13dp"
        android:src="@drawable/ic_jarvis_logo"
        android:contentDescription="JARVIS" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="J.A.R.V.I.S."
        android:textColor="?attr/themeTextPrimary"
        android:textStyle="bold"
        android:textSize="18sp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PERSONAL AI ASSISTANT"
        android:textColor="?attr/themeTextMuted"
        android:textSize="10sp"
        android:letterSpacing="0.12" />
</LinearLayout>