<?xml version="1.0" encoding="utf-8"?>
<!-- Lens-glass pane used to wrap cards at run time, so every Settings screen shares exactly the same glass. -->
<com.jarvis.assistant.ui.glass.LiquidGlassLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:lgCornerRadius="24dp"
    app:lgBezel="22"
    app:lgRefraction="16"
    app:lgVeil="0.08"
    app:lgSource="@id/glassBackdrop"
    app:lgPlainBackground="@drawable/bg_lg_card"
    app:lgPlainElevation="0dp" />
