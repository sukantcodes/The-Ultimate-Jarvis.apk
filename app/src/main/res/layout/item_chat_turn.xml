<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="20dp">

    <TextView
        android:id="@+id/tvTimestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:textColor="?attr/themeTextMuted"
        android:textSize="11sp"
        tools:text="19:45:10" />

    <!-- Same visual language as the live chat: soft card for you, plain text for JARVIS. -->
    <LinearLayout
        android:id="@+id/boxUserMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_cc_user"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat_label_you"
            android:textColor="?attr/themeTextMuted"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/tvUserTranscript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:lineSpacingExtra="3dp"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="15sp"
            tools:text="Hello JARVIS, how are you?" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/boxJarvisMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:paddingHorizontal="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat_label_jarvis"
            android:textColor="?attr/themeAccent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/tvJarvisResponse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:lineSpacingExtra="5dp"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="15sp"
            tools:text="Online and ready. How can I assist you today, Boss?" />
    </LinearLayout>

</LinearLayout>
