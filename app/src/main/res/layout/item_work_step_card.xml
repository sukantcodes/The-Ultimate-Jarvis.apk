<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- One compact row: step title (one line) | optional status tag | chevron -->
    <LinearLayout
        android:id="@+id/layoutRowMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="14dp"
        android:paddingTop="11dp"
        android:paddingBottom="11dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/tvWorkStepTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="14sp"
            android:textColor="?attr/themeTextSecondary"
            android:text="Working…" />

        <TextView
            android:id="@+id/tvWorkStepStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="13sp"
            android:textColor="#FF6E6E"
            android:visibility="gone"
            android:text="Failed" />

        <TextView
            android:id="@+id/tvWorkStepChevron"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="›"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?attr/themeTextSecondary"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Opens when the row is tapped: what was asked and what came back -->
    <LinearLayout
        android:id="@+id/layoutDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvRequestLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Request"
            android:textSize="12sp"
            android:textColor="?attr/themeTextSecondary"
            android:paddingStart="4dp" />

        <TextView
            android:id="@+id/tvRequestBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_work_step_code"
            android:fontFamily="monospace"
            android:padding="10dp"
            android:textColor="?attr/themeTextPrimary"
            android:textIsSelectable="true"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/tvResponseLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Response"
            android:textSize="12sp"
            android:textColor="?attr/themeTextSecondary"
            android:paddingStart="4dp" />

        <TextView
            android:id="@+id/tvResponseBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_work_step_code"
            android:fontFamily="monospace"
            android:padding="10dp"
            android:textColor="?attr/themeTextPrimary"
            android:textIsSelectable="true"
            android:textSize="11.5sp" />
    </LinearLayout>
</LinearLayout>
