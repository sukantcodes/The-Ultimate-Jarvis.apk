<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:id="@+id/viewRowDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#26FFFFFF"
        android:visibility="gone" />

    <!-- One row: tool icon | title (one line) | tag / tick | arrow -->
    <LinearLayout
        android:id="@+id/layoutRowMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="11dp"
        android:paddingBottom="11dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:id="@+id/ivWorkFrame"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_work_icon_frame">

            <ImageView
                android:id="@+id/ivWorkIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:scaleType="centerInside"
                android:contentDescription="@null" />
        </FrameLayout>

        <com.jarvis.assistant.ui.chat.ShimmerTextView
            android:id="@+id/tvWorkStepTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="14sp"
            android:fontFamily="@font/jarvis_sans_medium"
            android:textColor="?attr/themeTextSecondary"
            android:text="Working" />

        <TextView
            android:id="@+id/tvWorkStepStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FF6E6E"
            android:visibility="gone"
            android:text="Failed" />

        <TextView
            android:id="@+id/tvWorkStepChevron"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="›"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?attr/themeTextSecondary"
            android:visibility="gone" />
    </LinearLayout>

    <com.jarvis.assistant.ui.chat.ScanLineView
        android:id="@+id/viewScanLine"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:visibility="gone" />

    <!-- Opens when the row is tapped: what was asked and what came back -->
    <LinearLayout
        android:id="@+id/layoutDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvRequestLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Request"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/themeTextSecondary"
            android:paddingStart="4dp" />

        <TextView
            android:id="@+id/tvRequestBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_work_step_code"
            android:fontFamily="@font/jarvis_mono"
            android:padding="10dp"
            android:textColor="?attr/themeTextPrimary"
            android:textIsSelectable="true"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvResponseLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Response"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/themeTextSecondary"
            android:paddingStart="4dp" />

        <TextView
            android:id="@+id/tvResponseBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_work_step_code"
            android:fontFamily="@font/jarvis_mono"
            android:padding="10dp"
            android:textColor="?attr/themeTextPrimary"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
