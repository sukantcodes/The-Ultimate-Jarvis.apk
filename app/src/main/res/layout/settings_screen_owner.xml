<?xml version="1.0" encoding="utf-8"?>
<!-- Settings screen: Owner. Standalone layout, hosted by its own Activity (not nested in a parent settings layout). -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screenRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/themeBg">

    <!-- The scene behind every glass pane: the panes zoom and refract it. -->
    <com.jarvis.assistant.ui.glass.GlassBackdropView
        android:id="@+id/glassBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/contentColumn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <com.jarvis.assistant.ui.glass.LiquidGlassLayout
        android:id="@+id/glassBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:lgCornerRadius="24dp"
        app:lgBezel="22"
        app:lgRefraction="16"
        app:lgVeil="0.08"
        app:lgSource="@id/glassBackdrop"
        app:lgPlainBackground="@drawable/bg_lg_card"
        app:lgPlainElevation="0dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:src="@drawable/ic_back"
                app:tint="?attr/themeTextPrimary" />
        </com.jarvis.assistant.ui.glass.LiquidGlassLayout>

        <TextView
            android:id="@+id/tvScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/jarvis_serif_semibold"
            android:maxLines="2"
            android:text="@string/set_section_owner"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="26sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/screenScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.jarvis.assistant.ui.glass.LiquidGlassLayout
        android:id="@+id/glassCardOwner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="22dp"
        app:lgCornerRadius="28dp"
        app:lgBezel="22"
        app:lgRefraction="16"
        app:lgVeil="0.08"
        app:lgSource="@id/glassBackdrop"
        app:lgPlainBackground="@drawable/bg_lg_card"
        app:lgPlainElevation="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <LinearLayout
                    android:id="@+id/rowOwnerDashboard"
                    style="@style/Widget.JarvisSettings.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <FrameLayout
                        style="@style/Widget.JarvisSettings.IconBox"
                        android:layout_width="40dp"
                        android:layout_height="40dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_owner_dashboard"
                            app:tint="?attr/themeAccent" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.JarvisSettings.RowTitle.Owner"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/set_ownerdash_title" />

                        <TextView
                            style="@style/Widget.JarvisSettings.RowSubtitle.Owner"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/set_ownerdash_subtitle" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="?attr/themeTextMuted" />
                </LinearLayout>
            </LinearLayout>
            </com.jarvis.assistant.ui.glass.LiquidGlassLayout>
        </LinearLayout>
    </ScrollView>
    </LinearLayout>
</FrameLayout>
