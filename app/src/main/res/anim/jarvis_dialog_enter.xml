<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog blooms up from slightly below and smaller, easing into place. -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:shareInterpolator="false">
    <alpha android:duration="180" android:fromAlpha="0" android:toAlpha="1"
        android:interpolator="@interpolator/jarvis_standard" />
    <scale
        android:duration="420"
        android:fromXScale="0.90" android:toXScale="1"
        android:fromYScale="0.90" android:toYScale="1"
        android:pivotX="50%" android:pivotY="55%"
        android:interpolator="@interpolator/jarvis_emphasized_decelerate" />
    <translate android:duration="420" android:fromYDelta="6%" android:toYDelta="0%"
        android:interpolator="@interpolator/jarvis_emphasized_decelerate" />
</set>
