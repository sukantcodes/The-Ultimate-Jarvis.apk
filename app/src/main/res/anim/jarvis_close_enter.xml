<?xml version="1.0" encoding="utf-8"?>
<!-- The previous screen comes back: drifts in from the left, grows to full size and brightens. -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:shareInterpolator="false">
    <translate
        android:duration="440"
        android:fromXDelta="-7%p" android:toXDelta="0"
        android:interpolator="@interpolator/jarvis_emphasized_decelerate" />
    <scale
        android:duration="440"
        android:fromXScale="0.95" android:toXScale="1.0"
        android:fromYScale="0.95" android:toYScale="1.0"
        android:pivotX="50%" android:pivotY="50%"
        android:interpolator="@interpolator/jarvis_emphasized_decelerate" />
    <alpha
        android:duration="360"
        android:fromAlpha="0.45" android:toAlpha="1.0"
        android:interpolator="@interpolator/jarvis_standard" />
</set>
