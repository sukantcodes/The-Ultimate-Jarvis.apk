<?xml version="1.0" encoding="utf-8"?>
<!-- The previous screen comes forward again as the top one leaves. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_quint"
    android:shareInterpolator="true">
    <scale
        android:duration="280"
        android:fromXScale="0.94" android:toXScale="1.0"
        android:fromYScale="0.94" android:toYScale="1.0"
        android:pivotX="50%" android:pivotY="50%" />
    <alpha android:duration="280" android:fromAlpha="0.55" android:toAlpha="1.0" />
</set>
