<?xml version="1.0" encoding="utf-8"?>
<!-- The screen underneath recedes: it shrinks a little and dims. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_quint"
    android:shareInterpolator="true">
    <scale
        android:duration="320"
        android:fromXScale="1.0" android:toXScale="0.94"
        android:fromYScale="1.0" android:toYScale="0.94"
        android:pivotX="50%" android:pivotY="50%" />
    <alpha android:duration="320" android:fromAlpha="1.0" android:toAlpha="0.55" />
</set>
