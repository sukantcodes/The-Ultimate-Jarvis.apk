<?xml version="1.0" encoding="utf-8"?>
<!-- Compact status surface: subtle tonal gradient, soft outline, and pill geometry. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/themeAccentLight">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="?attr/themeChipBg"
                android:endColor="?attr/themeCardGlassEnd" />
            <stroke
                android:width="1dp"
                android:color="?attr/themeCardBorder" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</ripple>
