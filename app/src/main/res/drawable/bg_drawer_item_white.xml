<?xml version="1.0" encoding="utf-8"?>
<!-- Drawer row on white glass: a soft accent pill when selected, a faint grey wash when pressed, otherwise clear. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <inset android:insetLeft="10dp" android:insetRight="10dp" android:insetTop="3dp" android:insetBottom="3dp">
            <shape android:shape="rectangle">
                <solid android:color="?attr/themeAccentLight" />
                <stroke android:width="1dp" android:color="?attr/themeAccent" />
                <corners android:radius="22dp" />
            </shape>
        </inset>
    </item>
    <item android:state_pressed="true">
        <inset android:insetLeft="10dp" android:insetRight="10dp" android:insetTop="3dp" android:insetBottom="3dp">
            <shape android:shape="rectangle">
                <solid android:color="#18000000" />
                <corners android:radius="22dp" />
            </shape>
        </inset>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
