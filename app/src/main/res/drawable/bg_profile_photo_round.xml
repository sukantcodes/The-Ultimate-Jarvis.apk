<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded, theme-coordinated photo mask. The photo is clipped to these 24dp corners. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="18dp" />
    <stroke android:width="1dp" android:color="?attr/themeAccentLight" />
    <gradient
        android:angle="135"
        android:startColor="?attr/themeCardGlassStart"
        android:centerColor="?attr/themeAccentLight"
        android:endColor="?attr/themeCardGlassEnd" />
</shape>
