<?xml version="1.0" encoding="utf-8"?>
<!-- Circular, theme-coordinated photo mask: the photo is clipped to the same circle as the ring around it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <gradient
        android:angle="135"
        android:startColor="?attr/themeCardGlassStart"
        android:centerColor="?attr/themeAccentLight"
        android:endColor="?attr/themeCardGlassEnd" />
</shape>
