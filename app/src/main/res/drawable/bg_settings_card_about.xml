<?xml version="1.0" encoding="utf-8"?>
<!-- Settings card for the about section: theme surface with an accent-coloured outline. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/themeCardBg" />
            <corners android:radius="28dp" />
            <stroke android:width="1.5dp" android:color="@color/set_accent_about" />
        </shape>
    </item>
</layer-list>
