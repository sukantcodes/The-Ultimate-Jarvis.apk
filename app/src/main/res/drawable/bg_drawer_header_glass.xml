<?xml version="1.0" encoding="utf-8"?>
<!-- Drawer header: a rounded glass card in the theme's own glass colours. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="?attr/themeCardGlassStart"
        android:endColor="?attr/themeCardGlassEnd" />
    <stroke android:width="1dp" android:color="?attr/themeCardBorder" />
    <corners android:radius="28dp" />
</shape>
