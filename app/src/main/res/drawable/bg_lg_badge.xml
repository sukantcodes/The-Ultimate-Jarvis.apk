<?xml version="1.0" encoding="utf-8"?>
<!-- Compact theme-aware badge with a soft accent wash and crisp outline. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="?attr/themeChipBg"
        android:endColor="?attr/themeCardGlassEnd" />
    <stroke
        android:width="1dp"
        android:color="?attr/themeCardBorder" />
    <corners android:radius="20dp" />
</shape>
