<?xml version="1.0" encoding="utf-8"?>
<!-- Theme-aware input surface with a quiet border; focus and text behavior remain unchanged. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/themeCardGlassEnd" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="?attr/themeCardBorder" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
