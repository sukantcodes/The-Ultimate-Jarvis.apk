<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/themeCardBg" />
            <corners android:radius="30dp" />
            <stroke android:width="2dp" android:color="?attr/themeCardBorder" />
        </shape>
    </item>
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="?attr/themeCardGlassStart" android:centerColor="?attr/themeSurface" android:endColor="?attr/themeCardGlassEnd" />
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="?attr/themeGlassSpecular" />
        </shape>
    </item>
</layer-list>