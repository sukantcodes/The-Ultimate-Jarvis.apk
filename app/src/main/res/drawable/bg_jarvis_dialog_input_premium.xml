<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#2CFFFFFF" android:endColor="#12FFFFFF" />
            <corners android:radius="17dp" />
            <stroke android:width="2dp" android:color="?attr/themeAccent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#1CFFFFFF" android:endColor="#08FFFFFF" />
            <corners android:radius="17dp" />
            <stroke android:width="1dp" android:color="#30FFFFFF" />
        </shape>
    </item>
</selector>
