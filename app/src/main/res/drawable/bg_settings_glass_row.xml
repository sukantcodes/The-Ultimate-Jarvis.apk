<?xml version="1.0" encoding="utf-8"?>
<!-- Clean rounded row surface. No fixed-height specular overlay, which caused visible rectangular colour patches. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/themeAccentLight">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/themeCardGlassEnd" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</ripple>
