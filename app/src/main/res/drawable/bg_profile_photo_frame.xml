<?xml version="1.0" encoding="utf-8"?>
<!-- Raised, rounded glass bezel framing the user's profile photo. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#26000000" />
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="315"
                android:startColor="?attr/themeAccentLight"
                android:centerColor="?attr/themeCardGlassStart"
                android:endColor="?attr/themeAccent" />
            <stroke android:width="1dp" android:color="?attr/themeAccentLight" />
        </shape>
    </item>
</layer-list>
