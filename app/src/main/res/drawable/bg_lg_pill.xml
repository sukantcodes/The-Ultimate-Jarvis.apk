<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/lg_fill_strong" />
            <corners android:radius="40dp" />
        </shape>
    </item>
    <item android:gravity="top" android:height="18dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:endColor="#00FFFFFF" android:startColor="#30FFFFFF" />
            <corners android:topLeftRadius="40dp" android:topRightRadius="40dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/lg_stroke" />
            <corners android:radius="40dp" />
        </shape>
    </item>
</layer-list>
