<?xml version="1.0" encoding="utf-8"?>
<!-- iOS 26/27 Liquid Glass card: translucent crystal body + overhead sheen + crisp Fresnel hairline -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="?attr/themeCardGlassStart"
                android:centerColor="?attr/themeCardBg"
                android:endColor="?attr/themeCardGlassEnd" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="?attr/themeGlassSpecular"
                android:centerColor="#08FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="27dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="?attr/themeCardBorder" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
