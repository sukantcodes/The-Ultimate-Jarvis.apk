<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid glass panel: frosted translucent body, a soft light sheen along the top, and a thin glass edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/lg_fill" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item android:gravity="top" android:height="64dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#2EFFFFFF" />
            <corners android:topLeftRadius="26dp" android:topRightRadius="26dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/lg_stroke" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</layer-list>
