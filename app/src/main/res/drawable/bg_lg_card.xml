<?xml version="1.0" encoding="utf-8"?>
<!-- Soft, borderless liquid-glass surface. Ambient colour comes from the screen background,
     not a fixed-height gradient strip that reads as a rectangular colour patch. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/themeCardBg" />
            <corners android:radius="26dp" />
            <stroke android:width="1dp" android:color="?attr/themeAccentLight" />
        </shape>
    </item>
</layer-list>
