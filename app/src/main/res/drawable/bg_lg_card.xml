<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid-glass card: soft depth shadow, tinted glass body, top-lit sheen, crisp rim. Radius scale: card 28 / chip 20 / icon 18 / dock 36. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="3dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#14000000" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="?attr/themeCardGlassStart"
                android:endColor="?attr/themeCardGlassEnd" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#26FFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="?attr/themeCardBorder" />
        </shape>
    </item>
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="27dp" />
            <stroke android:width="0.5dp" android:color="#1FFFFFFF" />
        </shape>
    </item>
</layer-list>
