<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="?attr/themeCardGlassStart" android:endColor="?attr/themeCardGlassEnd" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="?attr/themeAccent" />
            <padding android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="?attr/themeCardGlassStart" android:endColor="?attr/themeCardGlassEnd" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="?attr/themeCardBorder" />
        </shape>
    </item>
</selector>