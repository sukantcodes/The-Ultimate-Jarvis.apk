<?xml version="1.0" encoding="utf-8"?>
<!-- User bubble: accent glass with a top sheen. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="22dp"
                android:topRightRadius="22dp"
                android:bottomLeftRadius="22dp"
                android:bottomRightRadius="6dp" />
            <gradient android:type="linear" android:angle="0" android:startColor="?attr/themeAccent1" android:endColor="?attr/themeAccent2" />
            <stroke android:width="1dp" android:color="#44FFFFFF" />
        </shape>
    </item>
    <item android:top="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="21dp"
                android:topRightRadius="21dp"
                android:bottomLeftRadius="21dp"
                android:bottomRightRadius="5dp" />
            <gradient
                android:angle="270"
                android:startColor="#33FFFFFF"
                android:centerColor="#0AFFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
