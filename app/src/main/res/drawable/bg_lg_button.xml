<?xml version="1.0" encoding="utf-8"?>
<!-- Glossy accent button: solid theme colour, bright sheen on top, thin light edge. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/themeAccent" />
                    <corners android:radius="28dp" />
                </shape>
            </item>
            <item android:gravity="top" android:height="26dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:endColor="#00FFFFFF" android:startColor="#59FFFFFF" />
                    <corners android:topLeftRadius="28dp" android:topRightRadius="28dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="1dp" android:color="#66FFFFFF" />
                    <corners android:radius="28dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
