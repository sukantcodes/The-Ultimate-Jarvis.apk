<?xml version="1.0" encoding="utf-8"?>
<!-- iOS 26/27 Liquid Glass accent CTA with luminous top specular and crisp glass rim -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#50FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/themeAccent" />
                    <corners android:radius="28dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#78FFFFFF" />
                </shape>
            </item>
            <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#55FFFFFF"
                        android:centerColor="#14FFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners android:radius="27dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</ripple>
