<?xml version="1.0" encoding="utf-8"?>
<!-- Soft accent halo behind the logo on the login screen. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="60dp"
                android:startColor="#552F6BFF"
                android:endColor="#002F6BFF" />
        </shape>
    </item>
    <item android:bottom="14dp" android:left="14dp" android:right="14dp" android:top="14dp">
        <shape android:shape="oval">
            <solid android:color="?attr/themeCardBg" />
            <stroke android:width="1.5dp" android:color="?attr/themeAccent" />
        </shape>
    </item>
</layer-list>
