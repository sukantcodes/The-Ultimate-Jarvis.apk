<?xml version="1.0" encoding="utf-8"?>
<!-- Theme-aware dimensional glass tile; the icon glyph is tinted from the active app accent. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#18000000" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="?attr/themeAccentLight"
                android:centerColor="?attr/themeCardGlassStart"
                android:endColor="?attr/themeCardGlassEnd" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:bottom="10dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="?attr/themeGlassSpecular"
                android:centerColor="#18FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="14dp" android:topRightRadius="14dp"
                android:bottomLeftRadius="7dp" android:bottomRightRadius="7dp" />
        </shape>
    </item>
</layer-list>
