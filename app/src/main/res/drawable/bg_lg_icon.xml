<?xml version="1.0" encoding="utf-8"?>
<!-- Glass icon tile tinted by the theme accent. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/lg_accent_fill" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:gravity="top" android:height="22dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#38FFFFFF" />
            <corners android:topLeftRadius="14dp" android:topRightRadius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/lg_accent_stroke" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
