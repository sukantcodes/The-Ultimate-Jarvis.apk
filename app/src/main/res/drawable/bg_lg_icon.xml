<?xml version="1.0" encoding="utf-8"?>
<!-- Theme-aware icon tile. The highlight follows the rounded silhouette, avoiding hard rectangular overlays. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#18000000" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="?attr/themeAccentLight"
                android:centerColor="?attr/themeCardGlassStart"
                android:endColor="?attr/themeCardGlassEnd" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="?attr/themeCardBorder" />
        </shape>
    </item>
    <item android:top="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="?attr/themeGlassSpecular"
                android:centerColor="#10FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
