<?xml version="1.0" encoding="utf-8"?>
<!-- Assistant bubble: glass body with top sheen and rim; tail corner kept small. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="22dp"
                android:topRightRadius="22dp"
                android:bottomLeftRadius="6dp"
                android:bottomRightRadius="22dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="?attr/themeCardGlassStart"
                android:endColor="?attr/themeCardGlassEnd" />
            <stroke android:width="1dp" android:color="?attr/themeCardBorder" />
        </shape>
    </item>
    <item android:top="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="21dp"
                android:topRightRadius="21dp"
                android:bottomLeftRadius="5dp"
                android:bottomRightRadius="21dp" />
            <gradient
                android:angle="270"
                android:startColor="#22FFFFFF"
                android:centerColor="#06FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
