<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded version pill for the Updates header. Uses theme tokens so it adapts
     to every theme (dark, liquid-glass and custom). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/themeChipBg" />
    <stroke
        android:width="1dp"
        android:color="?attr/themeAccent" />
    <corners android:radius="100dp" />
    <padding
        android:left="12dp"
        android:top="5dp"
        android:right="12dp"
        android:bottom="5dp" />
</shape>
