<?xml version="1.0" encoding="utf-8"?>
<!-- Drawer row: transparent normally, a glass pill (glossy, accent-lit) when selected, soft when pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <inset android:insetLeft="10dp" android:insetRight="10dp" android:insetTop="3dp" android:insetBottom="3dp">
            <layer-list>
                <item>
                    <shape android:shape="rectangle">
                        <solid android:color="?attr/themeAccentLight" />
                        <stroke android:width="1dp" android:color="?attr/themeAccent" />
                        <corners android:radius="28dp" />
                    </shape>
                </item>
                <item android:left="16dp" android:right="16dp" android:top="2dp" android:height="20dp" android:gravity="top|fill_horizontal">
                    <shape android:shape="rectangle">
                        <gradient android:angle="270" android:startColor="#5CFFFFFF" android:endColor="#05FFFFFF" />
                        <corners android:radius="12dp" />
                    </shape>
                </item>
            </layer-list>
        </inset>
    </item>
    <item android:state_pressed="true">
        <inset android:insetLeft="10dp" android:insetRight="10dp" android:insetTop="3dp" android:insetBottom="3dp">
            <shape android:shape="rectangle">
                <solid android:color="?attr/themeChipBg" />
                <corners android:radius="28dp" />
            </shape>
        </inset>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
