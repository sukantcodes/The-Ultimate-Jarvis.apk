<?xml version="1.0" encoding="utf-8"?>
<!-- Central voice action: orb-like accent gradient that follows the selected app theme. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#55FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="44dp"
                        android:startColor="?attr/themeAccentLight"
                        android:centerColor="?attr/themeAccent1"
                        android:endColor="?attr/themeAccent2" />
                    <stroke
                        android:width="2dp"
                        android:color="?attr/themeGlassSpecular" />
                </shape>
            </item>
            <item
                android:top="3dp"
                android:left="12dp"
                android:right="12dp"
                android:height="14dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#B3FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</ripple>
