<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid glass building blocks. Every colour comes from the active theme, so they suit every theme and accent. -->
<resources>
    <style name="Widget.LiquidGlass.Card" parent="">
        <item name="android:background">@drawable/bg_lg_card</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="Widget.LiquidGlass.Input" parent="">
        <item name="android:background">@drawable/bg_lg_input</item>
        <item name="android:textColor">?attr/themeTextPrimary</item>
        <item name="android:textColorHint">?attr/themeTextMuted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="Widget.LiquidGlass.Button" parent="">
        <item name="android:background">@drawable/bg_lg_button</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.LiquidGlass.Pill" parent="">
        <item name="android:background">@drawable/bg_lg_pill</item>
        <item name="android:textColor">?attr/themeTextPrimary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.LiquidGlass.Badge" parent="">
        <item name="android:background">@drawable/bg_lg_badge</item>
        <item name="android:textColor">?attr/themeAccent</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
    </style>

    <style name="Widget.LiquidGlass.Title" parent="">
        <item name="android:textColor">?attr/themeTextPrimary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.LiquidGlass.Subtitle" parent="">
        <item name="android:textColor">?attr/themeTextMuted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Widget.LiquidGlass.Label" parent="">
        <item name="android:textColor">?attr/themeTextMuted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>
</resources>
