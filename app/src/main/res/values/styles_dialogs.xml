<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shared app-wide Material dialogs. Colours resolve from the currently active JARVIS theme. -->
    <style name="ShapeAppearanceOverlay.Jarvis.Dialog" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">30dp</item>
    </style>

    <style name="TextAppearance.Jarvis.DialogTitle" parent="TextAppearance.Jarvis.Headline">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textSize">23sp</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Jarvis.DialogBody" parent="TextAppearance.Jarvis.Body">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.Jarvis.Dialog.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_jarvis_dialog_input</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingStart">15dp</item>
        <item name="android:paddingEnd">15dp</item>
        <item name="android:paddingTop">13dp</item>
        <item name="android:paddingBottom">13dp</item>
        <item name="android:minHeight">54dp</item>
    </style>

    <style name="Widget.Jarvis.Dialog.ActionButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:fontFamily">sans-serif-bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.025</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Jarvis.Dialog.WindowAnimation" parent="">
        <item name="android:windowEnterAnimation">@anim/jarvis_dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/jarvis_dialog_exit</item>
    </style>

    <style name="ThemeOverlay.Jarvis.MaterialDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowBackground">@drawable/bg_jarvis_dialog_surface</item>
        <item name="android:colorAccent">?attr/themeAccent</item>
        <item name="colorPrimary">?attr/themeAccent</item>
        <item name="colorSecondary">?attr/themeAccent2</item>
        <item name="colorTertiary">?attr/themeAccent3</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:editTextStyle">@style/Widget.Jarvis.Dialog.EditText</item>
        <item name="materialButtonStyle">@style/Widget.Jarvis.Dialog.ActionButton</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.Jarvis.Dialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.Jarvis.DialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.Jarvis.DialogBody</item>
        <item name="android:windowAnimationStyle">@style/Jarvis.Dialog.WindowAnimation</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:windowMinWidthMajor">87%</item>
        <item name="android:windowMinWidthMinor">87%</item>
    </style>

    <style name="Widget.Jarvis.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="android:background">@drawable/bg_jarvis_dialog_surface</item>
        <item name="backgroundTint">?attr/themeSurface</item>
        <item name="shapeAppearance">@style/ShapeAppearanceOverlay.Jarvis.Dialog</item>
        <item name="android:elevation">20dp</item>
    </style>

    <style name="ThemeOverlay.Jarvis.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Jarvis.BottomSheet</item>
        <item name="android:windowAnimationStyle">@style/Jarvis.Dialog.WindowAnimation</item>
    </style>
</resources>
