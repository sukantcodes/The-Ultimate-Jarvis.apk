<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shared app-wide Material dialogs. Colours resolve dynamically from the currently active JARVIS theme. -->
    <style name="ShapeAppearanceOverlay.Jarvis.Dialog" parent="">
        <item name="cornerSize">24dp</item>
    </style>

    <style name="TextAppearance.Jarvis.DialogTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">?attr/themeTextPrimary</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Jarvis.DialogBody" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:textColor">?attr/themeTextSecondary</item>
    </style>

    <style name="Widget.Jarvis.Dialog.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:textColor">?attr/themeTextPrimary</item>
        <item name="android:textColorHint">?attr/themeTextMuted</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.Jarvis.Dialog.ActionButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:fontFamily">sans-serif-bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Jarvis.Dialog.WindowAnimation" parent="">
        <item name="android:windowEnterAnimation">@anim/jarvis_dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/jarvis_dialog_exit</item>
    </style>

    <style name="ThemeOverlay.Jarvis.MaterialDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">?attr/themeCardBg</item>
        <item name="colorOnSurface">?attr/themeTextPrimary</item>
        <item name="colorOnSurfaceVariant">?attr/themeTextSecondary</item>
        <item name="android:textColorPrimary">?attr/themeTextPrimary</item>
        <item name="android:textColorSecondary">?attr/themeTextSecondary</item>
        <item name="android:textColorAlertDialogListItem">?attr/themeTextPrimary</item>
        <item name="colorPrimary">?attr/themeAccent</item>
        <item name="colorSecondary">?attr/themeAccent</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.Jarvis.DialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.Jarvis.DialogBody</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.Jarvis.Dialog</item>
        <item name="android:windowAnimationStyle">@style/Jarvis.Dialog.WindowAnimation</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="Widget.Jarvis.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">?attr/themeCardBg</item>
        <item name="shapeAppearance">@style/ShapeAppearanceOverlay.Jarvis.Dialog</item>
        <item name="android:elevation">20dp</item>
    </style>

    <style name="ThemeOverlay.Jarvis.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Jarvis.BottomSheet</item>
        <item name="android:windowAnimationStyle">@style/Jarvis.Dialog.WindowAnimation</item>
    </style>
</resources>
