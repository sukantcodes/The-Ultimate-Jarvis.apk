<?xml version="1.0" encoding="utf-8"?>
<!-- Settings "Control Deck" type system. Every section shares the same fonts and sizes; only the heading takes the section colour. -->
<resources>

    <!-- Ai section -->
    <style name="Widget.JarvisSettings.SectionTitle.Ai" parent="Widget.JarvisSettings.SectionTitle">
        <item name="android:textColor">@color/set_accent_ai</item>
        <item name="android:fontFamily">@font/jarvis_hud_medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>
    <style name="Widget.JarvisSettings.RowTitle.Ai" parent="Widget.JarvisSettings.RowTitle">
        <item name="android:fontFamily">@font/jarvis_round_semibold</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="Widget.JarvisSettings.RowSubtitle.Ai" parent="Widget.JarvisSettings.RowSubtitle">
        <item name="android:fontFamily">@font/jarvis_sans</item>
        <item name="android:textSize">12sp</item>
        <item name="android:layout_marginTop">3dp</item>
    </style>
    <style name="Widget.JarvisSettings.Divider.Ai" parent="Widget.JarvisSettings.Divider">
        <item name="android:background">?attr/themeCardBorder</item>
        <item name="android:alpha">0.80</item>
    </style>

