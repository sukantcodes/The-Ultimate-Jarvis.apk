<?xml version="1.0" encoding="utf-8"?>
<!-- Per-section fonts and colours for the Settings screen. Base Widget.JarvisSettings.* styles are untouched. -->
<resources>

    <!-- Ai section -->
    <style name="Widget.JarvisSettings.SectionTitle.Ai" parent="Widget.JarvisSettings.SectionTitle">
        <item name="android:textColor">@color/set_accent_ai</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="Widget.JarvisSettings.RowTitle.Ai" parent="Widget.JarvisSettings.RowTitle">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Widget.JarvisSettings.RowSubtitle.Ai" parent="Widget.JarvisSettings.RowSubtitle">
        <item name="android:fontFamily">sans-serif-light</item>
    </style>
    <style name="Widget.JarvisSettings.Divider.Ai" parent="Widget.JarvisSettings.Divider">
        <item name="android:background">@color/set_accent_ai</item>
        <item name="android:alpha">0.30</item>
    </style>

